    <!-- BOSCHINO: stop propagation + quantity sync -->
    <script>
      (function () {
        function stop(e) { e.stopPropagation(); }

        function bind(root) {
          if (!root || root.dataset.boschinoBound === '1') return;
          root.dataset.boschinoBound = '1';

          root.querySelectorAll('.quantity__button, .quantity__input, .quantity').forEach(function (el) {
            el.addEventListener('click', stop);
            el.addEventListener('pointerdown', stop);
            el.addEventListener('mousedown', stop);
            el.addEventListener('touchstart', stop, { passive: true });
          });

          root.querySelectorAll('.boschino-cta__btn').forEach(function (btn) {
            btn.addEventListener('click', stop);
            btn.addEventListener('pointerdown', stop);
            btn.addEventListener('mousedown', stop);
            btn.addEventListener('touchstart', stop, { passive: true });
          });

          var form = root.querySelector('form[id^="BoschinoCTA-"]');
          if (!form) return;

          form.addEventListener('submit', function () {
            var card = root.closest('.card-wrapper') || root;
            var qtyInput = card.querySelector('input.quantity__input');
            var hiddenQty = form.querySelector('[data-boschino-qty-hidden]');

            if (hiddenQty) {
              var val = qtyInput && qtyInput.value ? parseInt(qtyInput.value, 10) : 1;
              if (!val || val < 1) val = 1;
              hiddenQty.value = String(val);
            }
          }, true);
        }

        function init() {
          document.querySelectorAll('[data-boschino-cta]').forEach(bind);
        }

        document.addEventListener('DOMContentLoaded', init);
        document.addEventListener('shopify:section:load', init);
      })();
    </script>

    <!-- BOSCHINO: continue shopping redirect -->
    {% if template contains 'cart' or template contains 'checkout' %}
      <!-- checkout preloads a skripty zde -->
      <script>
        (function () {
          if (window.__boschinoContinueBound) return;
          window.__boschinoContinueBound = true;

          var KEY = 'boschino_continue_url_v2';

          function isCartOrCheckout(path) {
            return path.indexOf('/cart') === 0 || path.indexOf('/checkout') === 0;
          }

          function save(url) { try { sessionStorage.setItem(KEY, url); } catch (e) {} }
          function load() { try { return sessionStorage.getItem(KEY); } catch (e) { return null; } }

          function rememberLastBrowsePage() {
            if (isCartOrCheckout(location.pathname)) return;
            save(location.href);
          }
          rememberLastBrowsePage();

          function patchContinueLink() {
            if (!location.pathname || location.pathname.indexOf('/cart') !== 0) return;

            var url = load();
            if (!url) return;

            var candidates = Array.prototype.slice.call(
              document.querySelectorAll('a[href="/collections/all"], a[href*="/collections/all"]')
            );

            if (!candidates.length) {
              Array.prototype.slice.call(document.querySelectorAll('a')).forEach(function (a) {
                var t = (a.textContent || '').trim().toLowerCase();
                if (t.indexOf('pokračovat v nákupu') !== -1 || t.indexOf('continue shopping') !== -1) {
                  candidates.push(a);
                }
              });
            }

            candidates.forEach(function (a) {
              a.setAttribute('href', url);
              a.dataset.boschinoContinue = '1';
            });
          }

          patchContinueLink();
          document.addEventListener('DOMContentLoaded', patchContinueLink);
          document.addEventListener('shopify:section:load', patchContinueLink);

          function interceptContinue(e) {
            if (!location.pathname || location.pathname.indexOf('/cart') !== 0) return;

            var el = e.target && e.target.closest ? e.target.closest('a') : null;
            if (!el) return;

            var url = load();
            if (!url) return;

            var href = el.getAttribute('href') || '';
            var text = (el.textContent || '').trim().toLowerCase();

            var looksLikeContinue =
              el.dataset.boschinoContinue === '1' ||
              href === '/collections/all' ||
              href.indexOf('/collections/all') !== -1 ||
              text.indexOf('pokračovat v nákupu') !== -1 ||
              text.indexOf('continue shopping') !== -1;

            if (!looksLikeContinue) return;

            e.preventDefault();
            e.stopPropagation();
            if (e.stopImmediatePropagation) e.stopImmediatePropagation();

            window.location.href = url;
          }

          document.addEventListener('pointerdown', interceptContinue, true);
          document.addEventListener('click', interceptContinue, true);

          window.addEventListener('pageshow', rememberLastBrowsePage);
        })();
      </script>
    {% endif %}


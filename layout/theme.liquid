<!doctype html>
<html class="js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#E60118">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- comment -%}
      Favicons (bez duplicit):
      - SVG z Theme settings pro moderní prohlížeče
      - PNG 32x32 fallback (vyber 1 variantu: buď asset, nebo pevné CDN URL)
      - Apple touch icon 180x180 (vyber 1 variantu: buď asset, nebo pevné CDN URL)
    {%- endcomment -%}

    <!-- SVG favicon pro moderní prohlížeče -->
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/svg+xml" href="{{ settings.favicon | image_url }}">
    {%- endif -%}

    <!-- PNG fallback pro starší prohlížeče -->
    {%- comment -%}
      Preferujeme asset_url, aby to bylo pod kontrolou theme a bez hardcoded URL.
      Pokud chceš naopak používat CDN URL, smaž 2 řádky níže a odkomentuj CDN variantu.
    {%- endcomment -%}
    
    {%- comment -%}
    <!-- Alternativa (CDN, pokud nemáš soubory v assets):
    <link rel="icon" type="image/png" sizes="32x32" href="https://cdn.shopify.com/s/files/1/1001/0741/9979/files/boschino-favicon-1000px-bez_okraju.png?v=1771269583">
    <link rel="apple-touch-icon" sizes="180x180" href="https://cdn.shopify.com/s/files/1/1001/0741/9979/files/boschino-favicon-1000px-bez_okraju.png?v=1771269583">
    {%- endcomment -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {%- liquid
      assign boschino_title_base = page_title

      if request.page_type == 'collection' and collection
        if collection.handle == 'bosch-cerpadla-do-pracek'
          assign boschino_title_base = 'Čerpadla do praček Bosch a Siemens | ' | append: shop.name
        endif
      endif
    -%}

    <title>
      {{ boschino_title_base }}
      {%- if current_tags -%}
        &ndash; tagged "{{ current_tags | join: ', ' }}"
      {%- endif -%}
      {%- if current_page != 1 -%}
        &ndash; Page {{ current_page }}
      {%- endif -%}
      {%- unless boschino_title_base contains shop.name -%}
        &ndash; {{ shop.name }}
      {%- endunless -%}
    </title>

    {%- comment -%}
      BOSCHINO SEO SYSTEM – unified meta / OG / Twitter descriptions
      Priorita:
      1) metafield custom.seo_snippet
      2) legacy metafield custom.meta_description
      3) page_description
      4) fallback podle typu stránky
    {%- endcomment -%}

    {%- capture boschino_meta_desc_raw -%}
      {%- if request.page_type == 'collection' and collection -%}
        {%- if collection.metafields.custom.seo_snippet != blank -%}
          {{ collection.metafields.custom.seo_snippet }}
        {%- elsif collection.metafields.custom.meta_description != blank -%}
          {{ collection.metafields.custom.meta_description }}
        {%- elsif page_description != blank -%}
          {{ page_description }}
        {%- elsif collection.description != blank -%}
          {{ collection.description | strip_html }}
        {%- else -%}
          {{ page_title }}
        {%- endif -%}

      {%- elsif request.page_type == 'product' and product -%}
        {%- if product.metafields.custom.seo_snippet != blank -%}
          {{ product.metafields.custom.seo_snippet }}
        {%- elsif product.metafields.custom.meta_description != blank -%}
          {{ product.metafields.custom.meta_description }}
        {%- elsif page_description != blank -%}
          {{ page_description }}
        {%- elsif product.description != blank -%}
          {{ product.description | strip_html }}
        {%- else -%}
          {{ page_title }}
        {%- endif -%}

      {%- elsif request.page_type == 'article' and article -%}
        {%- if article.metafields.custom.seo_snippet != blank -%}
          {{ article.metafields.custom.seo_snippet }}
        {%- elsif article.metafields.custom.meta_description != blank -%}
          {{ article.metafields.custom.meta_description }}
        {%- elsif page_description != blank -%}
          {{ page_description }}
        {%- elsif article.excerpt != blank -%}
          {{ article.excerpt | strip_html }}
        {%- elsif article.content != blank -%}
          {{ article.content | strip_html }}
        {%- else -%}
          {{ page_title }}
        {%- endif -%}

      {%- elsif request.page_type == 'page' and page -%}
        {%- if page.metafields.custom.seo_snippet != blank -%}
          {{ page.metafields.custom.seo_snippet }}
        {%- elsif page.metafields.custom.meta_description != blank -%}
          {{ page.metafields.custom.meta_description }}
        {%- elsif page_description != blank -%}
          {{ page_description }}
        {%- elsif page.content != blank -%}
          {{ page.content | strip_html }}
        {%- else -%}
          {{ page_title }}
        {%- endif -%}

      {%- else -%}
        {%- if page_description != blank -%}
          {{ page_description }}
        {%- else -%}
          {{ page_title }}
        {%- endif -%}
      {%- endif -%}
    {%- endcapture -%}

    {%- capture boschino_meta_desc -%}
      {{
        boschino_meta_desc_raw
        | replace: '&nbsp;', ' '
        | replace: '&#160;', ' '
        | strip
        | truncate: 160, '…'
      }}
    {%- endcapture -%}

    {%- if boschino_meta_desc != blank -%}
      <meta name="description" content="{{ boschino_meta_desc | escape }}">
    {%- endif -%}

    {%- comment -%}
      FIX: urlTemplate se {search_term_string} nesmí skládat přes append.
      Použijeme capture → Liquid už to nikdy nerozbije.
    {%- endcomment -%}
    {%- assign home_url = request.origin | append: routes.root_url -%}
    {%- capture search_template -%}{{ request.origin }}{{ routes.search_url }}?q={search_term_string}{%- endcapture -%}

    {%- comment -%} JSON-LD pro homepage (jen index) {%- endcomment -%}
    {%- if request.page_type == 'index' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": "{{ home_url }}#organization",
            "name": "Boschino",
            "legalName": "Boschino",
            "url": "{{ home_url }}",
            "logo": {
              "@type": "ImageObject",
              "@id": "{{ home_url }}#logo",
              "url": "https://boschino.cz/cdn/shop/files/boschino_circle.svg"
            },
            "description": "Originální náhradní díly, příslušenství a komponenty pro domácí spotřebiče Bosch, Siemens a prémiové značky BSH.",
            "areaServed": [
              { "@type": "AdministrativeArea", "name": "Česká republika" },
              { "@type": "AdministrativeArea", "name": "Evropská unie" }
            ],
            "knowsAbout": [
              "náhradní díly Bosch",
              "náhradní díly Siemens",
              "originální příslušenství Bosch",
              "příslušenství Siemens",
              "BSH Group spare parts",
              "domácí spotřebiče BSH Group"
            ],
            "sameAs": [
              "https://www.facebook.com/people/Boschino/61585881047958/",
              "https://www.instagram.com/boschino.cz/"
            ]
          },
          {
            "@type": "WebSite",
            "@id": "{{ home_url }}#website",
            "name": "Boschino.cz",
            "url": "{{ home_url }}",
            "publisher": { "@id": "{{ home_url }}#organization" },
            "inLanguage": "{{ request.locale.iso_code }}",
            "potentialAction": {
              "@type": "SearchAction",
              "target": {
                "@type": "EntryPoint",
                "urlTemplate": {{ search_template | strip | json }}
              },
              "query-input": "required name=search_term_string"
            }
          },
          {
            "@type": "WebPage",
            "@id": "{{ home_url }}#webpage",
            "url": "{{ home_url }}",
            "name": "Boschino – expertní obchod pro Bosch & Siemens (BSH Group)",
            "isPartOf": { "@id": "{{ home_url }}#website" },
            "about": { "@id": "{{ home_url }}#organization" },
            "inLanguage": "{{ request.locale.iso_code }}",
            "primaryImageOfPage": { "@id": "{{ home_url }}#logo" },
            "description": {{ boschino_meta_desc | json }}
          }
        ]
      }
      </script>

      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://boschino.cz/#website-standalone",
        "name": "Boschino.cz",
        "url": "https://boschino.cz/",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://boschino.cz/search?q={search_term_string}",
          "query-input": "required name=search_term_string"
        },
        "inLanguage": "{{ request.locale.iso_code }}"
      }
      </script>
    {%- endif -%}

      {%- if false and request.page_type == 'product' and product -%}
      {%- assign product_url = request.origin | append: product.url -%}

      {%- comment -%} Metafields – UPRAV namespace/key podle reálných {%- endcomment -%}
      {%- assign mf_ean = product.metafields.custom.ean -%}
      {%- assign mf_mpn = product.metafields.custom.bsh_kod -%}
      {%- assign mf_rating_value = product.metafields.custom.rating_value -%}
      {%- assign mf_rating_count = product.metafields.custom.rating_count -%}
      {%- assign mf_reviews_json = product.metafields.custom.reviews_json -%}

      {%- assign gtin13 = '' -%}
      {%- if mf_ean != blank -%}
        {%- assign gtin13 = mf_ean | strip -%}
      {%- endif -%} 

      {%- assign mpn_value = '' -%}
      {%- if mf_mpn != blank -%}
        {%- assign mpn_value = mf_mpn | strip -%}
      {%- elsif product.selected_or_first_available_variant.sku != blank -%}
        {%- assign mpn_value = product.selected_or_first_available_variant.sku | strip -%}
      {%- endif -%}

      {%- comment -%}
        Brand normalizace: bereme product.vendor, ale mapujeme jen na povolené značky.
      {%- endcomment -%}
      {%- assign vendor_raw = product.vendor | default: '' | strip -%}
      {%- assign vendor_lc = vendor_raw | downcase -%}
      {%- assign brand_name = 'Boschino' -%}

      {%- if vendor_lc contains 'bsh' -%}
        {%- assign brand_name = 'BSH' -%}
      {%- elsif vendor_lc contains 'bosch' -%}
        {%- assign brand_name = 'Bosch' -%}
      {%- elsif vendor_lc contains 'siemens' -%}
        {%- assign brand_name = 'Siemens' -%}
      {%- elsif vendor_lc contains 'gaggenau' -%}
        {%- assign brand_name = 'Gaggenau' -%}
      {%- elsif vendor_lc contains 'constructa' -%}
        {%- assign brand_name = 'Constructa' -%}
      {%- elsif vendor_lc contains 'neff' -%}
        {%- assign brand_name = 'Neff' -%}
      {%- elsif vendor_lc contains 'balay' -%}
        {%- assign brand_name = 'Balay' -%}
      {%- endif -%}

      {%- liquid
        assign availability_label = product.metafields.custom.availability_label | default: '' | downcase | strip
        assign force_backorder = false
        assign has_backorder_variant = false

        if availability_label contains 'na objednání'
          assign force_backorder = true
        elsif availability_label contains 'na objednani'
          assign force_backorder = true
        elsif product.tags contains 'na_objednani'
          assign force_backorder = true
        elsif product.tags contains 'na objednání'
          assign force_backorder = true
        elsif product.tags contains 'na objednani'
          assign force_backorder = true
        endif

        for v in product.variants
          if v.inventory_policy == 'continue'
            assign has_backorder_variant = true
            break
          endif
        endfor

        assign product_availability_url = 'https://schema.org/OutOfStock'
        if force_backorder or has_backorder_variant
          assign product_availability_url = 'https://schema.org/BackOrder'
        elsif product.available
          assign product_availability_url = 'https://schema.org/InStock'
        endif

        assign primary_image_url = ''
        if product.featured_image != blank
          assign primary_image_url = product.featured_image | image_url: width: 1200 | prepend: 'https:'
        elsif product.featured_media != blank
          if product.featured_media.preview_image != blank
            assign primary_image_url = product.featured_media.preview_image | image_url: width: 1200 | prepend: 'https:'
          endif
        elsif product.images.first != blank
          assign primary_image_url = product.images.first | image_url: width: 1200 | prepend: 'https:'
        endif
      -%}

      {%- assign gtin13 = '' -%}
      {%- if mf_ean != blank -%}
        {%- assign gtin13 = mf_ean | strip -%}
      {%- endif -%}

      {%- assign mpn_value = '' -%}
      {%- if mf_mpn != blank -%}
        {%- assign mpn_value = mf_mpn | strip -%}
      {%- elsif product.selected_or_first_available_variant.sku != blank -%}
        {%- assign mpn_value = product.selected_or_first_available_variant.sku | strip -%}
      {%- endif -%}

      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Organization",
            "@id": {{ (home_url | append: "#organization") | json }},
            "name": "Boschino",
            "url": {{ home_url | json }},
            "logo": {
              "@type": "ImageObject",
              "@id": {{ (home_url | append: "#logo") | json }},
              "url": {{ "https://boschino.cz/cdn/shop/files/boschino_circle.svg" | json }}
            },
            "sameAs": [
              "https://www.facebook.com/people/Boschino/61585881047958/",
              "https://www.instagram.com/boschino.cz/"
            ]
          },
          {
            "@type": "WebSite",
            "@id": {{ (home_url | append: "#website") | json }},
            "name": "Boschino.cz",
            "url": {{ home_url | json }},
            "publisher": { "@id": {{ (home_url | append: "#organization") | json }} },
            "inLanguage": {{ request.locale.iso_code | json }},
            "potentialAction": {
              "@type": "SearchAction",
              "target": {
                "@type": "EntryPoint",
                "urlTemplate": {{ search_template | strip | json }}
              },
              "query-input": "required name=search_term_string"
            }
          },
          {
            "@type": "WebPage",
            "@id": {{ (product_url | append: "#webpage") | json }},
            "url": {{ product_url | json }},
            "name": {{ product.title | json }},
            "isPartOf": { "@id": {{ (home_url | append: "#website") | json }} },
            "about": { "@id": {{ (product_url | append: "#product") | json }} },
            "inLanguage": {{ request.locale.iso_code | json }}{%- if primary_image_url != blank -%},
            "primaryImageOfPage": {
              "@type": "ImageObject",
              "url": {{ primary_image_url | json }}
            }{%- endif -%}
          },
          {
            "@type": "ProductGroup",
            "@id": {{ (product_url | append: "#product") | json }},
            "name": {{ product.title | json }},
            "url": {{ product_url | json }},
            "description": {{ boschino_meta_desc | default: product.description | strip_html | strip | truncate: 600 | json }},
            "brand": { "@type": "Brand", "name": {{ brand_name | json }} },
            "image": [
              {%- assign printed_product_image = false -%}
              {%- for img in product.images limit: 6 -%}
                {%- assign img_url = img | image_url: width: 1200 | prepend: 'https:' -%}
                {{ img_url | json }}{% unless forloop.last %},{% endunless %}
                {%- assign printed_product_image = true -%}
              {%- endfor -%}
              {%- if printed_product_image == false and primary_image_url != blank -%}
                {{ primary_image_url | json }}
              {%- endif -%}
            ]
            {%- if mpn_value != blank -%}
              ,"mpn": {{ mpn_value | json }}
            {%- endif -%}
            {%- if gtin13 != blank -%}
              ,"gtin13": {{ gtin13 | json }}
            {%- endif -%},
            "hasVariant": [
              {%- for v in product.variants -%}
                {%- liquid
                  assign variant_availability_url = 'https://schema.org/OutOfStock'

                  if force_backorder or has_backorder_variant or v.inventory_policy == 'continue'
                    assign variant_availability_url = 'https://schema.org/BackOrder'
                  elsif v.available
                    assign variant_availability_url = 'https://schema.org/InStock'
                  endif

                  assign variant_image_url = ''
                  if v.image != blank
                    assign variant_image_url = v.image | image_url: width: 1200 | prepend: 'https:'
                  elsif primary_image_url != blank
                    assign variant_image_url = primary_image_url
                  endif
                -%}
                {
                  "@type": "Product",
                  "@id": {{ (product_url | append: "#variant-" | append: v.id) | json }},
                  "name": {{ product.title | append: " – " | append: v.title | json }},
                  "url": {{ product_url | append: "?variant=" | append: v.id | json }}
                  {%- if v.sku != blank -%}
                    ,"sku": {{ v.sku | json }}
                  {%- endif -%}
                  {%- if mpn_value != blank -%}
                    ,"mpn": {{ mpn_value | json }}
                  {%- elsif v.sku != blank -%}
                    ,"mpn": {{ v.sku | json }}
                  {%- endif -%}
                  {%- if gtin13 != blank -%}
                    ,"gtin13": {{ gtin13 | json }}
                  {%- endif -%}
                  {%- if variant_image_url != blank -%}
                    ,"image": {{ variant_image_url | json }}
                  {%- endif -%}
                  ,"brand": { "@type": "Brand", "name": {{ brand_name | json }} }
                  ,"offers": {
                    "@type": "Offer",
                    "priceCurrency": {{ cart.currency.iso_code | json }},
                    "price": {{ v.price | divided_by: 100.0 | json }},
                    "availability": {{ variant_availability_url | json }},
                    "itemCondition": "https://schema.org/NewCondition",
                    "url": {{ product_url | append: "?variant=" | append: v.id | json }}
                  }
                  {%- if mf_rating_value != blank and mf_rating_count != blank -%}
                    ,"aggregateRating": {
                      "@type": "AggregateRating",
                      "ratingValue": {{ mf_rating_value | json }},
                      "ratingCount": {{ mf_rating_count | json }}
                    }
                  {%- endif -%}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ],
            "offers": {
              {%- if product.variants.size > 1 -%}
                "@type": "AggregateOffer",
                "priceCurrency": {{ cart.currency.iso_code | json }},
                "lowPrice": {{ product.price_min | divided_by: 100.0 | json }},
                "highPrice": {{ product.price_max | divided_by: 100.0 | json }},
                "offerCount": {{ product.variants.size | json }},
                "availability": {{ product_availability_url | json }},
                "url": {{ product_url | json }}
              {%- else -%}
                "@type": "Offer",
                "priceCurrency": {{ cart.currency.iso_code | json }},
                "price": {{ product.price | divided_by: 100.0 | json }},
                "availability": {{ product_availability_url | json }},
                "itemCondition": "https://schema.org/NewCondition",
                "url": {{ product_url | json }}
              {%- endif -%}
            }
            {%- if mf_rating_value != blank and mf_rating_count != blank -%}
              ,"aggregateRating": {
                "@type": "AggregateRating",
                "ratingValue": {{ mf_rating_value | json }},
                "ratingCount": {{ mf_rating_count | json }}
              }
            {%- endif -%}
            {%- if mf_reviews_json != blank -%}
              ,"review": {{ mf_reviews_json.value }}
            {%- endif -%}
          }
        ]
      }
      </script>
    {%- endif -%}

    {% render 'meta-tags' %}

    <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-disclosure.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'details-modal.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'search-form.js' | asset_url }}" defer="defer"></script>

    {%- if settings.animations_reveal_on_scroll -%}
      <script src="{{ 'animations.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {{ content_for_header }}

    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
      assign body_font_italic = settings.type_body_font | font_modify: 'style', 'italic'
      assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
    %}

    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_italic | font_face: font_display: 'swap' }}
      {{ body_font_bold_italic | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}

      {% for scheme in settings.color_schemes -%}
        {% assign scheme_classes = scheme_classes | append: ', .color-' | append: scheme.id %}
        {% if forloop.index == 1 -%}
          :root,
        {%- endif %}
        .color-{{ scheme.id }} {
          --color-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
        {% if scheme.settings.background_gradient != empty %}
          --gradient-background: {{ scheme.settings.background_gradient }};
        {% else %}
          --gradient-background: {{ scheme.settings.background }};
        {% endif %}

        {% liquid
          assign background_color = scheme.settings.background
          assign background_color_brightness = background_color | color_brightness
          if background_color_brightness <= 26
            assign background_color_contrast = background_color | color_lighten: 50
          elsif background_color_brightness <= 65
            assign background_color_contrast = background_color | color_lighten: 5
          else
            assign background_color_contrast = background_color | color_darken: 25
          endif
        %}

        --color-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
        --color-background-contrast: {{ background_color_contrast.red }},{{ background_color_contrast.green }},{{ background_color_contrast.blue }};
        --color-shadow: {{ scheme.settings.shadow.red }},{{ scheme.settings.shadow.green }},{{ scheme.settings.shadow.blue }};
        --color-button: {{ scheme.settings.button.red }},{{ scheme.settings.button.green }},{{ scheme.settings.button.blue }};
        --color-button-text: {{ scheme.settings.button_label.red }},{{ scheme.settings.button_label.green }},{{ scheme.settings.button_label.blue }};
        --color-secondary-button: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
        --color-secondary-button-text: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
        --color-link: {{ scheme.settings.secondary_button_label.red }},{{ scheme.settings.secondary_button_label.green }},{{ scheme.settings.secondary_button_label.blue }};
        --color-badge-foreground: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
        --color-badge-background: {{ scheme.settings.background.red }},{{ scheme.settings.background.green }},{{ scheme.settings.background.blue }};
        --color-badge-border: {{ scheme.settings.text.red }},{{ scheme.settings.text.green }},{{ scheme.settings.text.blue }};
        --payment-terms-background-color: rgb({{ scheme.settings.background.rgb }});
      }
      {% endfor %}

      {{ scheme_classes | prepend: 'body' }} {
        color: rgba(var(--color-foreground), 0.75);
        background-color: rgb(var(--color-background));
      }

      :root {

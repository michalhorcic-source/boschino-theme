    <!-- BOSCHINO: autoscroll categories (SAFE – inside body) -->
    <script>
      (function () {
        function initAutoScroll() {
          var strips = document.querySelectorAll('.boschino-subcats');
          strips.forEach(function (strip) {
            if (strip.dataset.autoscrollInit === '1') return;
            strip.dataset.autoscrollInit = '1';

            var SPEED = 1;
            var PAUSE_MS = 1500;

            var pausedUntil = 0;
            var rafId = null;

            function loop() {
              if (Date.now() >= pausedUntil) {
                var maxScroll = strip.scrollWidth - strip.clientWidth;
                if (maxScroll > 0) {
                  strip.scrollLeft += SPEED;
                  if (strip.scrollLeft >= maxScroll - 1) strip.scrollLeft = 0;
                }
              }
              rafId = requestAnimationFrame(loop);
            }

            function start() { if (!rafId) rafId = requestAnimationFrame(loop); }
            function stop() { if (rafId) cancelAnimationFrame(rafId); rafId = null; }
            function pauseForUser() { pausedUntil = Date.now() + PAUSE_MS; }

            strip.addEventListener('mouseenter', stop);
            strip.addEventListener('mouseleave', start);
            strip.addEventListener('wheel', pauseForUser, { passive: true });
            strip.addEventListener('scroll', pauseForUser, { passive: true });
            strip.addEventListener('touchstart', stop, { passive: true });
            strip.addEventListener('touchend', function () { pauseForUser(); start(); }, { passive: true });

            start();
          });
        }

        document.addEventListener('DOMContentLoaded', initAutoScroll);
        document.addEventListener('shopify:section:load', initAutoScroll);
        if (document.readyState !== 'loading') initAutoScroll();
      })();
    </script>

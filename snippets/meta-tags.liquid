{%- comment -%}
Boschino – Social meta tags
- Collections: prefer short metafield description
- Fallbacks: page_description → stripped collection description → shop
{%- endcomment -%}

{%- assign boschino_social_desc = page_description | default: '' -%}

{%- if request.page_type == 'collection' and collection -%}
  {%- assign mf_meta = collection.metafields.custom.meta_description.value
    | default: collection.metafields.custom.meta_description
  -%}

  {%- assign boschino_social_desc = mf_meta | strip -%}

  {%- if boschino_social_desc == blank -%}
    {%- if page_description -%}
      {%- assign boschino_social_desc = page_description -%}
    {%- else -%}
      {%- assign boschino_social_desc = collection.description
        | strip_html
        | replace: '&nbsp;', ' '
        | replace: '&#160;', ' '
        | strip
        | truncate: 160, '…'
      -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = boschino_social_desc | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">

{%- comment -%} Custom OG and Twitter titles {%- endcomment -%}
{%- if template.name == 'index' -%}
  <meta property="og:title" content="Boschino – expertní obchod pro Bosch & Siemens (BSH Group)">
{%- else -%}
  <meta property="og:title" content="{{ page_title | escape }}">
{%- endif -%}

<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | divided_by: 100.0 | round: 2 }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site"
        content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">

{%- comment -%} Custom Twitter title {%- endcomment -%}
{%- if template.name == 'index' -%}
  <meta name="twitter:title" content="Originální spotřebiče, příslušenství a náhradní díly Bosch | Boschino">
{%- else -%}
  <meta name="twitter:title" content="{{ page_title | escape }}">
{%- endif -%}

<meta name="twitter:description" content="{{ og_description | escape }}">


<script>
(async () => {
  const SUPABASE_URL = "https://hbntpqlpcrodrhfjxhpv.supabase.co";
  const API_KEY = "sb_publishable_py5U4zoYoBusjy_rngRuWg_IcZ6o-AV";
  const target = document.getElementById('CompatibilityContent-{{ section.id }}');
  const partNumber = {{ mpn_value | json }};
  const PAGE_SIZE = 5;
  const SEARCH_DEBOUNCE_MS = 250;

  if (!target) return;

  if (!partNumber) {
    target.innerHTML = '<div class="compatibility-empty">Kompatibilita nenalezena.</div>';
    return;
  }

  const headers = {
    apikey: API_KEY,
    Authorization: `Bearer ${API_KEY}`
  };

  function escapeHtml(value) {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  function normalizeSearch(value) {
    return String(value ?? '')
      .trim()
      .replace(/[(),]/g, ' ')
      .replace(/\*/g, '')
      .replace(/\s+/g, ' ');
  }

  function buildRowsUrl(partNumberValue, query, from, to) {
    const params = new URLSearchParams();
    params.set('select', 'model_norm,brand,shopify_handle');
    params.set('part_number', `eq.${partNumberValue}`);
    params.set('order', 'model_norm.asc');

    if (query) {
      params.set('model_norm', `ilike.*${query}*`);
    }

    return {
      url: `${SUPABASE_URL}/rest/v1/product_compatibility_view?${params.toString()}`,
      extraHeaders: {
        'Range-Unit': 'items',
        'Range': `${from}-${to}`
      }
    };
  }

  function buildCountUrl(partNumberValue, query) {
    const params = new URLSearchParams();
    params.set('select', 'model_norm');
    params.set('part_number', `eq.${partNumberValue}`);

    if (query) {
      params.set('model_norm', `ilike.*${query}*`);
    }

    return {
      url: `${SUPABASE_URL}/rest/v1/product_compatibility_view?${params.toString()}`,
      extraHeaders: {
        'Range-Unit': 'items',
        'Range': '0-0',
        'Prefer': 'count=exact'
      }
    };
  }

  function getTotalCountFromResponse(response) {
    const contentRange = response.headers.get('content-range') || '';
    const match = contentRange.match(/\/(\d+)$/);
    return match ? Number(match[1]) : null;
  }

  async function fetchJson(url, extraHeaders = {}) {
    const response = await fetch(url, {
      headers: {
        ...headers,
        ...extraHeaders
      }
    });

    const text = await response.text();
    let data = null;

    try {
      data = text ? JSON.parse(text) : null;
    } catch (e) {
      data = text;
    }

    if (!response.ok) {
      const message =
        (data && typeof data === 'object' && (data.message || data.error || data.hint)) ||
        text ||
        `HTTP ${response.status}`;
      throw new Error(message);
    }

    return { response, data };
  }

  target.innerHTML = `
    <input
      type="text"
      class="compatibility-search"
      id="CompatibilitySearch-{{ section.id }}"
      placeholder="Vyhledejte model a ověřte si kompatibilitu toho dílu"
    >

    <div class="compatibility-count" id="CompatibilityCount-{{ section.id }}">
      Načítám kompatibility…
    </div>

    <div class="compatibility-table-wrap">
      <table class="compatibility-table">
        <thead>
          <tr>
            <th>Značka</th>
            <th>Model</th>
          </tr>
        </thead>
        <tbody id="CompatibilityTableBody-{{ section.id }}">
          <tr>
            <td class="compatibility-empty" colspan="2">Načítám…</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="compatibility-actions">
      <button
        type="button"
        class="compatibility-more"
        id="CompatibilityMore-{{ section.id }}"
        style="display:none;"
      >
        Zobrazit více
      </button>
    </div>
  `;

  const searchInput = document.getElementById('CompatibilitySearch-{{ section.id }}');
  const countEl = document.getElementById('CompatibilityCount-{{ section.id }}');
const bodyEl = document.getElementById('CompatibilityTableBody-{{ section.id }}');
const moreBtn = document.getElementById('CompatibilityMore-{{ section.id }}');
const badgeEl = document.getElementById('CompatibilityBadge-{{ section.id }}');

  let currentQuery = '';
  let loadedRows = [];
  let totalCount = 0;
  let offset = 0;
  let debounceTimer = null;
  let requestVersion = 0;
  let isLoadingMore = false;

  function renderRows() {
    if (!loadedRows.length) {
      bodyEl.innerHTML = `
        <tr>
          <td class="compatibility-empty" colspan="2">
            ${currentQuery ? 'Nic nebylo nalezeno.' : 'Usilovně pracujeme na doplnění. Pro urychlení nás prosím kontaktujte.'}
          </td>
        </tr>
      `;
      moreBtn.style.display = 'none';
      return;
    }

    bodyEl.innerHTML = loadedRows.map(item => `
      <tr>
        <td>${escapeHtml(item.brand || '—')}</td>
        <td>
          ${item.handle
            ? `<a href="/pages/appliance/${escapeHtml(item.handle)}">${escapeHtml(item.model)}</a>`
            : `${escapeHtml(item.model)}`
          }
        </td>
      </tr>
    `).join('');

    moreBtn.style.display = loadedRows.length < totalCount ? 'inline-block' : 'none';
  }

  function renderCount() {
  if (currentQuery) {
    countEl.textContent = `${totalCount} nalezených kompatibilních spotřebičů`;
  } else {
    countEl.textContent = `${totalCount} kompatibilních spotřebičů`;
  }

  if (badgeEl) {
    if (totalCount > 0) {
      badgeEl.hidden = false;
      badgeEl.textContent = totalCount === 1 ? '1 model' : `${totalCount} modelů`;
    } else {
      badgeEl.hidden = true;
    }
  }
}

  async function loadCount(query, version) {
    const { url, extraHeaders } = buildCountUrl(partNumber, query);
    const { response } = await fetchJson(url, extraHeaders);

    if (version !== requestVersion) return;

    totalCount = getTotalCountFromResponse(response) ?? 0;
    renderCount();
    moreBtn.style.display = loadedRows.length < totalCount ? 'inline-block' : 'none';
  }

  async function loadFirstPage(query) {
    const version = ++requestVersion;
    currentQuery = query;
    loadedRows = [];
    offset = 0;
    totalCount = 0;
    isLoadingMore = false;

    countEl.textContent = query ? 'Vyhledávám…' : 'Načítám kompatibility…';
    bodyEl.innerHTML = `
      <tr>
        <td class="compatibility-empty" colspan="2">Načítám…</td>
      </tr>
    `;
    moreBtn.style.display = 'none';

    const rowsRequest = buildRowsUrl(partNumber, query, 0, PAGE_SIZE - 1);

    try {
      const [rowsResult] = await Promise.all([
        fetchJson(rowsRequest.url, rowsRequest.extraHeaders),
        loadCount(query, version)
      ]);

      if (version !== requestVersion) return;

      const data = Array.isArray(rowsResult.data) ? rowsResult.data : [];

      loadedRows = data.map(item => ({
        brand: (item.brand || '').trim(),
        model: (item.model_norm || '').trim(),
        handle: (item.shopify_handle || '').trim()
      })).filter(item => item.model);

      offset = loadedRows.length;
      renderRows();

      if (!totalCount) {
        totalCount = loadedRows.length;
        renderCount();
      }
    } catch (error) {
      if (version !== requestVersion) return;
      target.innerHTML = '<div class="compatibility-empty">Chyba načítání.</div>';
      console.error('Compatibility load error:', error);
    }
  }

  async function loadMore() {
    if (isLoadingMore) return;
    if (offset >= totalCount) return;

    isLoadingMore = true;
    moreBtn.disabled = true;
    moreBtn.textContent = 'Načítám…';

    const version = requestVersion;
    const rowsRequest = buildRowsUrl(partNumber, currentQuery, offset, offset + PAGE_SIZE - 1);

    try {
      const { data } = await fetchJson(rowsRequest.url, rowsRequest.extraHeaders);

      if (version !== requestVersion) return;

      const newRows = (Array.isArray(data) ? data : []).map(item => ({
        brand: (item.brand || '').trim(),
        model: (item.model_norm || '').trim(),
        handle: (item.shopify_handle || '').trim()
      })).filter(item => item.model);

      loadedRows = loadedRows.concat(newRows);
      offset = loadedRows.length;
      renderRows();
    } catch (error) {
      console.error('Compatibility load more error:', error);
    } finally {
      isLoadingMore = false;
      moreBtn.disabled = false;
      moreBtn.textContent = 'Zobrazit více';
    }
  }

  searchInput.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    const query = normalizeSearch(searchInput.value);

    debounceTimer = setTimeout(() => {
      loadFirstPage(query);
    }, SEARCH_DEBOUNCE_MS);
  });

  moreBtn.addEventListener('click', () => {
    loadMore();
  });

  loadFirstPage('');
})();
</script>


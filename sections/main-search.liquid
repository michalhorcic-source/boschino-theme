<script>
  (function(){
    if (window.__boschinoSearchQtyInit) return;
    window.__boschinoSearchQtyInit = true;

    function stripWrappingQuotes(value) {
      return String(value || '').trim().replace(/^["']+|["']+$/g, '');
    }

    const rawTerm = {{ search.terms | json }};
const searchTerm = stripWrappingQuotes(rawTerm || '').trim();
const exactPartRegex = /^(?:00|1|2)\d{6}$/;

const modelInfoEl = document.getElementById('model-parts');

function showPartLoading() {
  if (!modelInfoEl) return;
  modelInfoEl.innerHTML = 'Ověřuji číslo dílu…';
  modelInfoEl.style.display = 'block';
}

    function hideModelInfoBox() {
      const modelInfoEl = document.getElementById('model-parts');
      if (modelInfoEl) {
        modelInfoEl.style.display = 'none';
        modelInfoEl.innerHTML = '';
      }
    }

    function updateCartButtonState(form) {
      const qtyInput = form.querySelector('input[name="quantity"]');
      const addBtn = form.querySelector('.boschino-cta__btn');
      if (!qtyInput || !addBtn) return;

      const available = (addBtn.getAttribute('data-available') === 'true');
      const v = parseInt(qtyInput.value || '0', 10);

      if (!available) {
        addBtn.setAttribute('disabled', 'disabled');
        return;
      }

      if (v > 0) addBtn.removeAttribute('disabled');
      else addBtn.setAttribute('disabled', 'disabled');
    }

    function buildMissingPartMessage() {
      const emailInput = document.getElementById('BoschinoMissingPartEmail');
      const descriptionInput = document.getElementById('BoschinoMissingPartDescription');
      const applianceInput = document.getElementById('BoschinoMissingPartAppliance');
      const noteInput = document.getElementById('BoschinoMissingPartNote');
      const hiddenBody = document.getElementById('BoschinoMissingPartBody');
      const fixedText = document.getElementById('BoschinoMissingPartFixedText');
      const description = descriptionInput ? descriptionInput.value.trim() : '';

      if (!hiddenBody || !fixedText) return;

      const email = emailInput ? emailInput.value.trim() : '';
      const appliance = applianceInput ? applianceInput.value.trim() : '';
      const extraNote = noteInput ? noteInput.value.trim() : '';

      const fixedMessage =
        'Dobrý den,\n' +
        'sháním náhradní díl: ' + searchTerm + (description ? ', ' + description : '') + '\n' +
        'pro spotřebič: ' + (appliance || '[model spotřebiče]') + '\n\n' +
        'Prověřte prosím dostupnost a kontaktujte mě na e-mailu: ' + (email || '[doplňte e-mail]');

      fixedText.textContent = fixedMessage;

      hiddenBody.value = extraNote
        ? fixedMessage + '\n\n' + extraNote
        : fixedMessage;
    }

    function showMissingPartBox(hasSimilarResults) {
      const box = document.getElementById('BoschinoPartNotFound');
      const toggle = document.getElementById('BoschinoSimilarResultsToggle');
      const gridContainer = document.getElementById('ProductGridContainer');
      const countEl = document.getElementById('ProductCountDesktop');
      const pagination = document.querySelector('.pagination-wrapper');
      const toggleBtn = document.getElementById('BoschinoToggleSimilarResults');

      hideModelInfoBox();

      if (box) box.classList.add('is-visible');

      if (toggle) {
        if (hasSimilarResults) toggle.classList.add('is-visible');
        else toggle.classList.remove('is-visible');
      }

      if (gridContainer) {
        gridContainer.style.display = 'none';
      }

      if (toggleBtn) {
        toggleBtn.setAttribute('aria-expanded', 'false');
      }

      if (countEl) {
        countEl.textContent = 'Výsledky: 0';
      }

      if (pagination) {
        pagination.style.display = 'none';
      }

      buildMissingPartMessage();
    }

    function hideMissingPartBox() {
      const box = document.getElementById('BoschinoPartNotFound');
      const toggle = document.getElementById('BoschinoSimilarResultsToggle');
      const gridContainer = document.getElementById('ProductGridContainer');
      const toggleBtn = document.getElementById('BoschinoToggleSimilarResults');

      if (box) box.classList.remove('is-visible');
      if (toggle) toggle.classList.remove('is-visible');

      if (gridContainer) {
        gridContainer.style.display = '';
      }

      if (toggleBtn) {
        toggleBtn.setAttribute('aria-expanded', 'false');
      }
    }

    function applyExactPartFilter() {
  const items = Array.from(document.querySelectorAll('#product-grid > li.grid__item[data-part-code]'));
  const pagination = document.querySelector('.pagination-wrapper');
  const countEl = document.getElementById('ProductCountDesktop');

  if (!exactPartRegex.test(searchTerm)) {
  hideMissingPartBox();
  return;
}

  showPartLoading();

  const exactMatches = items.filter((item) => {
    const code = String(item.dataset.partCode || '').trim().replace(/^["']+|["']+$/g, '');
    return code === searchTerm;
  });

  if (exactMatches.length > 0) {
    hideModelInfoBox();
    hideMissingPartBox();

    items.forEach((item) => {
      item.style.display = exactMatches.includes(item) ? '' : 'none';
    });

    if (countEl) {
      countEl.textContent = 'Výsledky: ' + exactMatches.length;
    }

    if (pagination) {
      pagination.style.display = 'none';
    }

    return;
  }

  showMissingPartBox(items.length > 0);
}

    function initVisibleForms() {
      document.querySelectorAll('.boschino-form').forEach(updateCartButtonState);
    }

    document.addEventListener('click', function(e) {
      const minus = e.target.closest('.boschino-minus');
      const plus  = e.target.closest('.boschino-plus');

      if (!minus && !plus) return;

      e.preventDefault();
      e.stopPropagation();

      const form = e.target.closest('.boschino-form');
      if (!form) return;

      const input = form.querySelector('input[name="quantity"]');
      if (!input) return;

      const current = parseInt(input.value || '0', 10);

      if (plus) input.value = current + 1;
      if (minus) input.value = Math.max(0, current - 1);

      updateCartButtonState(form);
    }, true);

    document.addEventListener('input', function(e) {
      const qty = e.target.closest('input[name="quantity"]');
      if (qty) {
        const form = e.target.closest('.boschino-form');
        if (!form) return;

        const v = parseInt(qty.value || '0', 10);
        if (isNaN(v) || v < 0) qty.value = 0;

        updateCartButtonState(form);
      }

      if (
        e.target &&
        (
          e.target.id === 'BoschinoMissingPartEmail' ||
          e.target.id === 'BoschinoMissingPartDescription' ||
          e.target.id === 'BoschinoMissingPartAppliance' ||
          e.target.id === 'BoschinoMissingPartNote'
        )
      ) {
        buildMissingPartMessage();
      }
    });

    document.addEventListener('submit', function(e){
      const form = e.target.closest('.boschino-form');
      if (form) {
        const qty = form.querySelector('input[name="quantity"]');
        const addBtn = form.querySelector('.boschino-cta__btn');
        if (!qty || !addBtn) return;

        const available = (addBtn.getAttribute('data-available') === 'true');
        const v = parseInt(qty.value || '0', 10);

        if (!available || v <= 0) {
          e.preventDefault();
          updateCartButtonState(form);
        }

        return;
      }

      if (e.target && e.target.id === 'BoschinoMissingPartForm') {
        buildMissingPartMessage();
      }
    });

    document.addEventListener('DOMContentLoaded', function() {
      initVisibleForms();
      buildMissingPartMessage();
      applyExactPartFilter();

      const toggleBtn = document.getElementById('BoschinoToggleSimilarResults');
      const gridContainer = document.getElementById('ProductGridContainer');

      if (toggleBtn && gridContainer) {
        toggleBtn.addEventListener('click', function() {
          const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
          toggleBtn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
          gridContainer.style.display = isOpen ? 'none' : '';
        });
      }
    });

    document.addEventListener('change', function(e) {
      if (e.target && (e.target.id === 'SortBy' || e.target.name === 'sort_by')) {
        setTimeout(function() {
          initVisibleForms();
          buildMissingPartMessage();
          applyExactPartFilter();
        }, 250);

        setTimeout(function() {
          initVisibleForms();
          buildMissingPartMessage();
          applyExactPartFilter();
        }, 700);
      }
    });

    const productGridContainer = document.getElementById('ProductGridContainer');
    if (productGridContainer) {
      const observer = new MutationObserver(function() {
        initVisibleForms();
        buildMissingPartMessage();
        applyExactPartFilter();
      });

      observer.observe(productGridContainer, {
        childList: true,
        subtree: true
      });
    }
  })();
</script>

      {%- endpaginate -%}
    {%- else -%}
      <div class="search-page">
        <h1 class="h2 center">{{ 'templates.search.title' | t }}</h1>
      </div>
    {%- endif -%}
  </div>
</div>


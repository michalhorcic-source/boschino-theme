{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}

{%- style -%}
/* =========================
   BOSCHINO – SEARCH UI (stejný vzhled jako kolekce)
   ========================= */

.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;

  --bosch-blue: #2a3885;
  --bosch-red: #e20015;

  --ui-bg: #E5E7E8;

  --text-strong: rgba(0,0,0,0.88);
  --text-soft: rgba(0,0,0,0.62);

  --border-soft: rgba(42,56,133,0.22);
  --shadow-soft: 0 10px 22px rgba(0,0,0,0.10);
  --shadow-hover: 0 18px 34px rgba(42,56,133,0.18);

  --bottom-dark: #255da0;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

/* Jemné pozadí sekce */
.section-{{ section.id }}-padding.gradient {
  background: var(--ui-bg) !important;
}

/* Ultra wide (jako kolekce) */
.section-{{ section.id }}-padding .page-width {
  max-width: none !important;
  width: min(1800px, calc(100vw - 56px)) !important;
  padding-left: 28px !important;
  padding-right: 28px !important;
}
@media screen and (min-width: 1600px) {
  .section-{{ section.id }}-padding .page-width {
    width: min(2100px, calc(100vw - 64px)) !important;
    padding-left: 32px !important;
    padding-right: 32px !important;
  }
}

/* Layout pro vertical facets */
@media screen and (min-width: 990px) {
  .section-{{ section.id }}-padding .facets-vertical {
    grid-template-columns: 260px 1fr !important;
    column-gap: 28px !important;
  }
}

/* Grid spacing */
.section-{{ section.id }}-padding .boschino-product-grid {
  gap: 22px !important;
}
@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding .boschino-product-grid {
    gap: 28px !important;
  }
}

/* =========================
   TOP BAR (Řadit podle + počet) – podle kolekce
   ========================= */
.section-{{ section.id }}-padding .facets-vertical-sort {
  position: sticky;
  top: 0;
  z-index: 6;
  padding-top: 10px;
  padding-bottom: 10px;
  margin-bottom: 16px;
  background: transparent;
}

.section-{{ section.id }}-padding .facets-vertical-sort .facets-vertical-form {
  background: #ffffff !important;
  border: 2px solid rgba(42,56,133,0.18) !important;
  border-left: 6px solid var(--bosch-blue) !important;
  border-radius: 0 !important;
  box-shadow: 0 10px 22px rgba(0,0,0,0.08) !important;
  padding: 14px !important;

  display: flex !important;
  align-items: center !important;
  gap: 14px !important;
}

.section-{{ section.id }}-padding .facets-vertical-sort .facet-filters {
  display: flex !important;
  align-items: center !important;
  justify-content: flex-start !important;
  margin: 0 !important;
  flex: 0 0 auto !important;
}

.section-{{ section.id }}-padding .facets-vertical-sort .facet-filters__field {
  display: flex !important;
  align-items: center !important;
  gap: 12px !important;
  position: static !important;
  left: auto !important;
  transform: none !important;
  margin-left: 0 !important;
  min-width: unset !important;
}

.section-{{ section.id }}-padding .facets-vertical-sort .facet-filters__label {
  margin: 0 !important;
  font-size: 14px !important;
  font-weight: 800 !important;
  color: var(--text-soft) !important;
  white-space: nowrap !important;
}

.section-{{ section.id }}-padding .facets-vertical-sort .select {
  width: 420px !important;
  max-width: 420px !important;
  position: relative !important;
}

.section-{{ section.id }}-padding .facets-vertical-sort .facet-filters__sort,
.section-{{ section.id }}-padding .facets-vertical-sort .select__select {
  width: 100% !important;
  border: 1px solid rgba(42,56,133,0.28) !important;
  border-radius: 0 !important;
  background: #fff !important;
  color: var(--text-strong) !important;
  font-weight: 800 !important;
  font-size: 15px !important;
  padding: 14px 42px !important;
  text-align: center !important;
  text-align-last: center !important;
}

.section-{{ section.id }}-padding .facets-vertical-sort .select .svg-wrapper {
  position: absolute !important;
  right: 14px !important;
  top: 50% !important;
  transform: translateY(-50%) !important;
  pointer-events: none !important;
  margin: 0 !important;
  color: var(--bosch-blue) !important;
}

.section-{{ section.id }}-padding .facets-vertical-sort .product-count-vertical {
  margin-left: auto !important;
  white-space: nowrap !important;
  flex: 0 0 auto !important;
}
.section-{{ section.id }}-padding .facets-vertical-sort .product-count__text {
  font-size: 13px !important;
  font-weight: 800 !important;
  color: var(--text-soft) !important;
}

@media screen and (max-width: 989px) {
  .section-{{ section.id }}-padding .facets-vertical-sort .facets-vertical-form {
    display: block !important;
  }
  .section-{{ section.id }}-padding .facets-vertical-sort .select {
    width: 100% !important;
    max-width: 100% !important;
  }
  .section-{{ section.id }}-padding .facets-vertical-sort .product-count-vertical {
    margin-left: 0 !important;
    margin-top: 10px !important;
  }
}
.section-{{ section.id }}-padding .required{
  color: var(--bosch-red);
  margin-left: 4px;
}

/* =========================
   FILTRY – větší písmo + checkbox styl
   ========================= */
.section-{{ section.id }}-padding .facets__heading,
.section-{{ section.id }}-padding .facets__summary,
.section-{{ section.id }}-padding .facets__title {
  font-size: 16px !important;
  font-weight: 900 !important;
  letter-spacing: 0 !important;
  text-transform: none !important;
}

.section-{{ section.id }}-padding .facets__item label,
.section-{{ section.id }}-padding .facet-checkbox {
  font-size: 16px !important;
  font-weight: 800 !important;
  color: rgba(0,0,0,0.84) !important;
  text-transform: none !important;
}

/* schovej dawn checkbox ikonky */
.section-{{ section.id }}-padding .facets label.facet-checkbox .facet-checkbox__checkbox,
.section-{{ section.id }}-padding .facets label.facet-checkbox .facet-checkbox__checkbox-icon,
.section-{{ section.id }}-padding .facets label.facet-checkbox .icon-checkmark,
.section-{{ section.id }}-padding .facets label.facet-checkbox svg.icon-checkmark,
.section-{{ section.id }}-padding .facets label.facet-checkbox .icon-square,
.section-{{ section.id }}-padding .facets label.facet-checkbox svg.icon-square,
.section-{{ section.id }}-padding .facets label.facet-checkbox .icon-checkbox,
.section-{{ section.id }}-padding .facets label.facet-checkbox svg.icon-checkbox,
.section-{{ section.id }}-padding .facets label.facet-checkbox > input[type="checkbox"] + svg{
  display: none !important;
}

/* řádek klikací + prostor pro box */
.section-{{ section.id }}-padding .facets label.facet-checkbox{
  position: relative !important;
  display: flex !important;
  align-items: center !important;
  gap: 10px !important;
  cursor: pointer !important;
  padding-left: 34px !important;
}

/* input funkční, neviditelný */
.section-{{ section.id }}-padding .facets label.facet-checkbox > input[type="checkbox"]{
  position: absolute !important;
  opacity: 0 !important;
  width: 1px !important;
  height: 1px !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* černý rámeček */
.section-{{ section.id }}-padding .facets label.facet-checkbox::before{
  content: "" !important;
  position: absolute !important;
  left: 0 !important;
  top: 50% !important;
  transform: translateY(-50%) !important;
  width: 22px !important;
  height: 22px !important;
  border: 3px solid #000 !important;
  background: #fff !important;
  box-sizing: border-box !important;
  pointer-events: none !important;
}

/* fajfka PNG */
.section-{{ section.id }}-padding .facets label.facet-checkbox:has(> input[type="checkbox"]:checked)::after{
  content: "" !important;
  position: absolute !important;
  pointer-events: none !important;
  left: 11px !important;
  top: 50% !important;
  width: 48px !important;
  height: 36px !important;
  background-repeat: no-repeat !important;
  background-position: center !important;
  background-size: contain !important;
  background-image: url("https://cdn.shopify.com/s/files/1/1001/0741/9979/files/fajfka_png.png?v=1769163383") !important;
  transform: translate(-35%, -65%) !important;
}

/* =========================
   KARTY PRODUKTŮ (search) – STEJNÉ JAKO COLLECTION
   ========================= */

/* karta */
.section-{{ section.id }}-padding #product-grid .card-wrapper,
.section-{{ section.id }}-padding #product-grid .card {
  border: 1.5px solid var(--border-soft) !important;
  outline: 1px solid rgba(0,0,0,0.04);
  border-radius: 0 !important;
  background: #ffffff !important;
  box-shadow: var(--shadow-soft) !important;
  overflow: hidden !important;
  position: relative !important;
}

/* horní lišta */
.section-{{ section.id }}-padding #product-grid .card-wrapper::before,
.section-{{ section.id }}-padding #product-grid .card::before {
  content: "";
  position: absolute;
  top: 0; left: 0;
  height: 3px; width: 100%;
  background: linear-gradient(90deg, var(--bosch-blue), var(--bosch-red));
  z-index: 50;
}

/* hover */
.section-{{ section.id }}-padding #product-grid .card-wrapper:hover,
.section-{{ section.id }}-padding #product-grid .card-wrapper:focus-within {
  border-color: rgba(0,0,0,0.38) !important;
  box-shadow: var(--shadow-hover) !important;
  transform: translateY(-1px) !important;
}

/* stejné výšky karet */
.section-{{ section.id }}-padding #product-grid .card {
  display: flex !important;
  flex-direction: column !important;
  height: 100% !important;
}
.section-{{ section.id }}-padding #product-grid .card__content{
  display: flex !important;
  flex-direction: column !important;
  flex: 1 1 auto !important;
}

/* zrušit dawn ratio */
.section-{{ section.id }}-padding #product-grid .card__inner.ratio::before,
.section-{{ section.id }}-padding #product-grid .card__media.ratio::before,
.section-{{ section.id }}-padding #product-grid .ratio::before {
  content: none !important;
  display: none !important;
}

/* MEDIA BOX – FIX (CENTER + CONTAIN) */
.section-{{ section.id }}-padding #product-grid .card__inner,
.section-{{ section.id }}-padding #product-grid .card__media,
.section-{{ section.id }}-padding #product-grid .card__media-wrapper{
  height: 250px !important;
  min-height: 250px !important;
  background: #fff !important;
  padding: 0 !important;
  overflow: hidden !important;
}

.section-{{ section.id }}-padding #product-grid .card__media > a.media.media--transparent{
  height: 250px !important;
  min-height: 250px !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 !important;
  background:#fff !important;
  overflow:hidden !important;
}

.section-{{ section.id }}-padding #product-grid .card__media > a.media.media--transparent img{
  position: static !important;
  transform: none !important;
  width: auto !important;
  height: auto !important;
  max-width: 100% !important;
  max-height: 100% !important;
  object-fit: contain !important;
  display: block !important;
  margin: 0 !important;
}

/* spodní část gradient */
.section-{{ section.id }}-padding #product-grid .card__content {
  padding: 0 !important;
  background: linear-gradient(
    180deg,
    #ffffff 0%,
    #ffffff 22%,
    rgba(37, 93, 160, 0.10) 45%,
    rgba(37, 93, 160, 0.35) 68%,
    rgba(37, 93, 160, 0.65) 85%,
    var(--bottom-dark) 100%
  ) !important;
}

.section-{{ section.id }}-padding #product-grid .card__information {
  padding: 18px 16px 10px 16px !important;
  margin-top: 6px !important;
  background: transparent !important;
}

.section-{{ section.id }}-padding #product-grid .card__heading{
  color: rgba(0,0,0,0.88) !important;
  font-size: 15.5px !important;
  font-weight: 900 !important;
  line-height: 1.25 !important;
  text-transform: none !important;
  min-height: 3.9em !important;
  margin: 0 !important;
}

.section-{{ section.id }}-padding #product-grid .card__heading a{
  color: rgba(0,0,0,0.88) !important;
  font-size: 15.5px !important;
  font-weight: 900 !important;
  line-height: 1.25 !important;
  text-transform: none !important;
  text-decoration: none !important;
  display: -webkit-box !important;
  -webkit-line-clamp: 3 !important;
  -webkit-box-orient: vertical !important;
  overflow: hidden !important;
}

/* cena */
.section-{{ section.id }}-padding #product-grid .price,
.section-{{ section.id }}-padding #product-grid .price-item {
  color: var(--bosch-blue) !important;
  font-size: 16px !important;
  font-weight: 900 !important;
}

/* vypnout stretched link */
.section-{{ section.id }}-padding #product-grid .card__heading a::after,
.section-{{ section.id }}-padding #product-grid a.full-unstyled-link::after{
  content:none !important;
  display:none !important;
}

/* MNOŽSTVÍ + CTA */
.section-{{ section.id }}-padding #product-grid .boschino-actions {
  padding: 12px 16px 12px 16px !important;
  position: relative !important;
  z-index: 5 !important;
  margin-top: auto !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-quantity {
  width: 100% !important;
  margin: 0 !important;
  display: grid !important;
  grid-template-columns: 56px 1fr 56px !important;
  height: 46px !important;
  min-height: 46px !important;
  border: 1px solid rgba(255,255,255,0.60) !important;
  background: rgba(255,255,255,0.94) !important;
  border-radius: 0 !important;
  overflow: hidden !important;
  box-shadow: none !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-quantity button{
  width: 56px !important;
  height: 46px !important;
  border: 0 !important;
  background: transparent !important;
  cursor: pointer !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 0 !important;
  margin: 0 !important;
  font-size: 0 !important;
  font-weight: 400 !important;
  position: relative !important;
  z-index: 6 !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-quantity .boschino-minus::before{
  content: "−" !important;
  font-size: 18px !important;
  font-weight: 400 !important;
  line-height: 1 !important;
  color: rgba(0,0,0,0.70) !important;
  display: block !important;
}
.section-{{ section.id }}-padding #product-grid .boschino-quantity .boschino-plus::before{
  content: "+" !important;
  font-size: 18px !important;
  font-weight: 400 !important;
  line-height: 1 !important;
  color: rgba(0,0,0,0.70) !important;
  display: block !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-quantity .boschino-minus{
  border-right: 1px solid rgba(0,0,0,0.12) !important;
}
.section-{{ section.id }}-padding #product-grid .boschino-quantity .boschino-plus{
  border-left: 1px solid rgba(0,0,0,0.12) !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-quantity button:hover{
  background: rgba(0,0,0,0.04) !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-quantity input{
  width: 100% !important;
  border: 0 !important;
  outline: none !important;
  box-shadow: none !important;
  background: transparent !important;
  text-align: center !important;
  font-weight: 400 !important;
  font-size: 14px !important;
  color: rgba(0,0,0,0.75) !important;
  padding: 0 !important;
  margin: 0 !important;
  -webkit-appearance: none !important;
  appearance: none !important;
  position: relative !important;
  z-index: 6 !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-quantity input::-webkit-outer-spin-button,
.section-{{ section.id }}-padding #product-grid .boschino-quantity input::-webkit-inner-spin-button{
  -webkit-appearance: none !important;
  margin: 0 !important;
}
.section-{{ section.id }}-padding #product-grid .boschino-quantity input[type=number]{
  -moz-appearance: textfield !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-cta{
  display: flex !important;
  align-items: stretch !important;
  width: 100% !important;
  margin: 10px 0 0 0 !important;
  padding: 0 !important;
  border: 1px solid rgba(255,255,255,0.60) !important;
  background: rgba(255,255,255,0.94) !important;
  min-height: 46px !important;
  border-radius: 0 !important;
  overflow: hidden !important;
  box-sizing: border-box !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-cta__detail{
  flex: 1 1 auto !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  height: 46px !important;
  border: 0 !important;
  background: transparent !important;
  color: rgba(0,0,0,0.88) !important;
  font-weight: 900 !important;
  text-decoration: none !important;
  white-space: nowrap !important;
  min-width: 0 !important;
  position: relative !important;
  z-index: 6 !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-cta__cart{
  flex: 0 0 56px !important;
  display: flex !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-cta__btn{
  width: 56px !important;
  height: 46px !important;
  border: 0 !important;
  background: transparent !important;
  cursor: pointer !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  border-left: 1px solid rgba(0,0,0,0.12) !important;
  outline: none !important;
  box-shadow: none !important;
  -webkit-appearance: none !important;
  appearance: none !important;
  position: relative !important;
  z-index: 6 !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-cta__btn:hover,
.section-{{ section.id }}-padding #product-grid .boschino-cta__detail:hover{
  background: rgba(0,0,0,0.04) !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-cart-ico{
  width: 18px !important;
  height: 18px !important;
  display: block !important;
}

/* skladovost pod cenou */
.section-{{ section.id }}-padding #product-grid .boschino-stock{
  margin-top: 6px !important;
  font-size: 13px !important;
  font-weight: 800 !important;
  color: rgba(0,0,0,0.62) !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-stock__status{
  display: inline-flex !important;
  align-items: center !important;
  gap: 6px !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-stock__status::before{
  content: "" !important;
  width: 8px !important;
  height: 8px !important;
  border-radius: 999px !important;
  display: inline-block !important;
  background: #2ecc71 !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-stock__status--in::before{
  background: #2ecc71 !important;
}
.section-{{ section.id }}-padding #product-grid .boschino-stock__status--order::before{
  background: #f1c40f !important;
}
.section-{{ section.id }}-padding #product-grid .boschino-stock__status--out::before{
  background: #e74c3c !important;
}

/* disabled vzhled */
.section-{{ section.id }}-padding #product-grid .boschino-cta__btn[disabled]{
  opacity: 0.45 !important;
  cursor: not-allowed !important;
  pointer-events: none !important;
}
.section-{{ section.id }}-padding #product-grid .boschino-quantity button[disabled],
.section-{{ section.id }}-padding #product-grid .boschino-quantity input[disabled]{
  opacity: 0.5 !important;
  cursor: not-allowed !important;
  pointer-events: none !important;
}

/* ostré hrany + bez dvojitých rohů */
.section-{{ section.id }}-padding #product-grid .card-wrapper,
.section-{{ section.id }}-padding #product-grid .card {
  border-radius: 0 !important;
}
.section-{{ section.id }}-padding #product-grid .card * {
  border-radius: 0 !important;
}
.section-{{ section.id }}-padding #product-grid .boschino-quantity,
.section-{{ section.id }}-padding #product-grid .boschino-cta,
.section-{{ section.id }}-padding #product-grid .boschino-quantity *,
.section-{{ section.id }}-padding #product-grid .boschino-cta * {
  border-radius: 0 !important;
  outline: none !important;
  box-shadow: none !important;
}
.section-{{ section.id }}-padding #product-grid input,
.section-{{ section.id }}-padding #product-grid button,
.section-{{ section.id }}-padding #product-grid .button,
.section-{{ section.id }}-padding #product-grid .field__input,
.section-{{ section.id }}-padding #product-grid .select__select {
  border-radius: 0 !important;
  outline: none !important;
  box-shadow: none !important;
}

/* profi patch */
.section-{{ section.id }}-padding #product-grid .card-wrapper,
.section-{{ section.id }}-padding #product-grid .card{
  box-shadow: 0 6px 16px rgba(0,0,0,0.08) !important;
  outline: none !important;
}

.section-{{ section.id }}-padding #product-grid .card-wrapper:hover,
.section-{{ section.id }}-padding #product-grid .card-wrapper:focus-within{
  box-shadow: 0 10px 22px rgba(0,0,0,0.12) !important;
}

.section-{{ section.id }}-padding #product-grid .card__heading{
  font-size: 14px !important;
  line-height: 1.2 !important;
  min-height: 3.6em !important;
}

.section-{{ section.id }}-padding #product-grid .card__heading a{
  font-size: 14px !important;
  line-height: 1.2 !important;
  display: -webkit-box !important;
  -webkit-line-clamp: 3 !important;
  -webkit-box-orient: vertical !important;
  overflow: hidden !important;
}

.section-{{ section.id }}-padding #product-grid .price,
.section-{{ section.id }}-padding #product-grid .price-item{
  font-size: 16.5px !important;
}

.section-{{ section.id }}-padding #product-grid .card-wrapper::before,
.section-{{ section.id }}-padding #product-grid .card::before{
  height: 2px !important;
}

.section-{{ section.id }}-padding #product-grid .card__media > a.media.media--transparent{
  padding-top: 8px !important;
}

.section-{{ section.id }}-padding #product-grid .card__media > a.media.media--transparent img{
  margin-top: 0 !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-cta__detail{
  font-weight: 900 !important;

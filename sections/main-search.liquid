  {%- endif -%}
{%- endfor -%}
<div id="model-parts" style="margin:12px 0;padding:12px;border:1px solid #ddd;">
  Hledám díly pro model: <b>{{ search.terms | escape }}</b> …
</div>

<script>
(async () => {
  const rawSearchTerm = {{ search.terms | json }};
  const shopifyProductResultsCount = {{ boschino_product_results_count | default: 0 }};
  const modelInfoEl = document.getElementById("model-parts");
  if (!modelInfoEl) return;

  const SUPABASE_URL = "https://hbntpqlpcrodrhfjxhpv.supabase.co/rest/v1";
  const RPC_URL = SUPABASE_URL + "/rpc/search_models";
  const SUPABASE_KEY = "sb_publishable_py5U4zoYoBusjy_rngRuWg_IcZ6o-AV";

  const SUPABASE_HEADERS = {
    "apikey": SUPABASE_KEY,
    "Authorization": "Bearer " + SUPABASE_KEY,
    "Content-Type": "application/json"
  };

  const TYPO_RULES = [
    { from: "0", to: "O" },
    { from: "O", to: "0" },
    { from: "1", to: "I" },
    { from: "I", to: "1" },
    { from: "8", to: "B" },
    { from: "B", to: "8" },
    { from: "5", to: "S" },
    { from: "S", to: "5" },
    { from: "2", to: "Z" },
    { from: "Z", to: "2" },
    { from: "VV", to: "W" },
    { from: "W", to: "VV" }
  ];

  function stripWrappingQuotes(value) {
    return String(value || "").trim().replace(/^["']+|["']+$/g, "");
  }

  const searchTerm = stripWrappingQuotes(rawSearchTerm);
  const normalizedQuery = searchTerm.toUpperCase();

  function hideModelInfo() {
    modelInfoEl.style.display = "none";
    modelInfoEl.innerHTML = "";
  }

  function showModelInfo(html) {
    modelInfoEl.innerHTML = html;
    modelInfoEl.style.display = "block";
  }

  if (!searchTerm) {
    hideModelInfo();
    return;
  }

  if (searchTerm.includes(" ")) {
    hideModelInfo();
    return;
  }

  function applianceSlug(value) {
    return String(value || "")
      .toLowerCase()
      .replace(/\s+/g, "")
      .replace(/\//g, "-")
      .replace(/\(/g, "_")
      .replace(/\)/g, "");
  }

  function applianceUrl(itemOrModel) {
    if (!itemOrModel) return null;

    if (typeof itemOrModel === "string") {
      return "/pages/appliance/" + applianceSlug(itemOrModel);
    }

    if (itemOrModel.shopify_handle) {
      return "/pages/appliance/" + itemOrModel.shopify_handle;
    }

    return "/pages/appliance/" + applianceSlug(itemOrModel.model_norm || "");
  }

  function isDigitsOnly(value) {
    return /^\d+$/.test(String(value || "").trim());
  }

  function isPartNumberCandidate(value) {
    return /^(?:00|1|2)\d{6}$/.test(String(value || "").trim());
  }

  function isWildcardModelCandidate(value) {
    const normalized = String(value || "").trim().toUpperCase();

    if (!normalized) return false;
    if (normalized.includes(" ")) return false;
    if (/[\/()]/.test(normalized)) return false;
    if (isPartNumberCandidate(normalized)) return false;
    if (isDigitsOnly(normalized)) return false;
    if (!normalized.includes("?")) return false;

    const knownChars = normalized.replace(/\?/g, "");
    return knownChars.length >= 2;
  }

  function looksLikeModelQuery(value) {
    const normalized = String(value || "").trim().toUpperCase();

    if (!normalized) return false;
    if (normalized.includes(" ")) return false;
    if (isDigitsOnly(normalized)) return false;
    if (isPartNumberCandidate(normalized)) return false;

    const hasLetter = /[A-Z]/.test(normalized);
    const hasDigit = /\d/.test(normalized);
    const hasModelChars = /[\/()?]/.test(normalized);

    return (hasLetter && hasDigit) || hasModelChars;
  }

  function getModelBase(value) {
    return String(value || "").trim().toUpperCase().split("/")[0];
  }

  function getKnownPositionEntries(value) {
    const base = getModelBase(value);
    const entries = [];

    for (let i = 0; i < base.length; i++) {
      const char = base[i];
      if (char && char !== "?") {
        entries.push({ index: i, char: char });
      }
    }

    return entries;
  }

  function getLookupPrefix(value) {
    const base = getModelBase(value);
    let prefix = "";

    for (let i = 0; i < base.length; i++) {
      const char = base[i];
      if (char === "?") break;
      prefix += char;
    }

    return prefix;
  }

  function modelMatchesKnownPositions(modelValue, rawQuery) {
    const modelBase = getModelBase(modelValue);
    const knownEntries = getKnownPositionEntries(rawQuery);

    if (!knownEntries.length) return false;

    for (const entry of knownEntries) {
      if (modelBase.length <= entry.index) return false;
      if (modelBase[entry.index] !== entry.char) return false;
    }

    return true;
  }

  function unique(values) {
    return [...new Set((values || []).filter(Boolean))];
  }

  function uniqueByModel(items) {
    return (items || []).filter(
      (item, index, arr) =>
        arr.findIndex(x => String(x.model_norm || "").trim() === String(item.model_norm || "").trim()) === index
    );
  }

  function applyRuleAt(value, index, from, to) {
    return value.slice(0, index) + to + value.slice(index + from.length);
  }

  function buildTypoVariantsOnce(value) {
    const variants = [];

    for (const rule of TYPO_RULES) {
      let startIndex = 0;

      while (startIndex < value.length) {
        const index = value.indexOf(rule.from, startIndex);
        if (index === -1) break;

        variants.push(applyRuleAt(value, index, rule.from, rule.to));
        startIndex = index + 1;
      }
    }

    return unique(variants).filter(v => v !== value);
  }

  function buildTypoVariantsTwice(value) {
    const once = buildTypoVariantsOnce(value);
    const twice = [];

    for (const firstVariant of once) {
      twice.push(...buildTypoVariantsOnce(firstVariant));
      if (twice.length > 200) break;
    }

    return unique(twice).filter(v => v !== value);
  }

  async function fetchExactAppliance(modelValue) {
    const url =
      SUPABASE_URL +
      "/appliances" +
      "?select=model_norm,shopify_handle" +
      "&model_norm=eq." + encodeURIComponent(modelValue) +
      "&limit=1";

    const res = await fetch(url, { headers: SUPABASE_HEADERS });
    if (!res.ok) return null;

    const data = await res.json();

    if (Array.isArray(data) && data.length > 0) {
      return {
        model_norm: (data[0].model_norm || "").trim(),
        shopify_handle: (data[0].shopify_handle || "").trim()
      };
    }

    return null;
  }

  async function fetchModelsRpc(q) {
    const res = await fetch(RPC_URL, {
      method: "POST",
      headers: SUPABASE_HEADERS,
      body: JSON.stringify({ q: (q || "").toUpperCase() })
    });

    if (!res.ok) return [];
    const data = await res.json();

    if (!Array.isArray(data)) return [];

    return data
      .map(item => {
        if (typeof item === "string") return item.trim();
        if (item && typeof item.model === "string") return item.model.trim();
        return "";
      })
      .filter(Boolean);
  }

  async function fetchAppliancesByModels(models) {
    const uniqueModels = unique(
      (models || []).map(v => String(v || "").trim().toUpperCase())
    ).slice(0, 50);

    if (!uniqueModels.length) return [];

    const conditions = uniqueModels
      .map(model => "model_norm.eq." + encodeURIComponent(model))
      .join(",");

    const url =
      SUPABASE_URL +
      "/appliances" +
      "?select=model_norm,shopify_handle" +
      "&or=(" + conditions + ")" +
      "&order=model_norm.asc" +
      "&limit=50";

    const res = await fetch(url, { headers: SUPABASE_HEADERS });
    if (!res.ok) return [];

    const data = await res.json();
    if (!Array.isArray(data)) return [];

    return data
      .map(item => ({
        model_norm: (item.model_norm || "").trim(),
        shopify_handle: (item.shopify_handle || "").trim()
      }))
      .filter(item => item.model_norm);
  }

  function isShortModelPrefixCandidate(value) {
    const normalized = String(value || "").trim().toUpperCase();

    if (!normalized) return false;
    if (normalized.includes(" ")) return false;
    if (normalized.includes("?")) return false;
    if (/[\/()]/.test(normalized)) return false;
    if (isPartNumberCandidate(normalized)) return false;
    if (isDigitsOnly(normalized)) return false;
    if (normalized.length < 4) return false;

    const hasLetter = /[A-Z]/.test(normalized);
    const hasDigit = /\d/.test(normalized);

    return hasLetter && hasDigit;
  }

  async function fetchPrefixCandidates(rawValue) {
    const normalized = String(rawValue || "").trim().toUpperCase();
    if (!isShortModelPrefixCandidate(normalized)) return [];

    const url =
      SUPABASE_URL +
      "/appliances" +
      "?select=model_norm,shopify_handle" +
      "&model_norm=like." + encodeURIComponent(normalized + "%") +
      "&order=model_norm.asc" +
      "&limit=50";

    const res = await fetch(url, { headers: SUPABASE_HEADERS });
    if (!res.ok) return [];

    const data = await res.json();
    if (!Array.isArray(data)) return [];

    return data
      .map(item => ({
        model_norm: (item.model_norm || "").trim(),
        shopify_handle: (item.shopify_handle || "").trim()
      }))
      .filter(item => item.model_norm);
  }

  async function fetchWildcardCandidates(rawValue) {
    const normalized = String(rawValue || "").trim().toUpperCase();
    const base = getModelBase(normalized);
    const prefix = getLookupPrefix(normalized);
    const knownEntries = getKnownPositionEntries(normalized);

    if (knownEntries.length < 2) return [];

    let url =
      SUPABASE_URL +
      "/appliances" +
      "?select=model_norm,shopify_handle";

    if (prefix.length >= 1) {
      url += "&model_norm=like." + encodeURIComponent(prefix + "%");
    }

    url += "&order=model_norm.asc&limit=50";

    const res = await fetch(url, { headers: SUPABASE_HEADERS });
    if (!res.ok) return [];

    const data = await res.json();
    if (!Array.isArray(data)) return [];

    return data
      .map(item => ({
        model_norm: (item.model_norm || "").trim(),
        shopify_handle: (item.shopify_handle || "").trim()
      }))
      .filter(item => item.model_norm)
      .filter(item => modelMatchesKnownPositions(item.model_norm, base));
  }

  async function fetchPartsForModel(modelValue) {
    const url =
      SUPABASE_URL +
      "/rpc/parts_for_model_only" +
      "?p_model_norm=" + encodeURIComponent(modelValue) +
      "&apikey=" + SUPABASE_KEY;

    const res = await fetch(url);
    if (!res.ok) return [];

    const data = await res.json();
    return Array.isArray(data) ? data : [];
  }

  async function fetchPossibleModelCandidates(rawValue) {
    const q = String(rawValue || "").trim().toUpperCase();
    if (!q) return [];

    if (isWildcardModelCandidate(q)) {
      return uniqueByModel(await fetchWildcardCandidates(q));
    }

    const exactMatch = await fetchExactAppliance(q);
    if (exactMatch) return [exactMatch];

    const rpcMatches = await fetchModelsRpc(q);
    if (rpcMatches.length) {
      const rpcAppliances = await fetchAppliancesByModels(rpcMatches);
      if (rpcAppliances.length) return uniqueByModel(rpcAppliances);
    }

    const prefixMatches = await fetchPrefixCandidates(q);
    if (prefixMatches.length) return uniqueByModel(prefixMatches);

    const canUseTypoLogic =
      !q.includes(" ") &&
      !q.includes("?") &&
      !isPartNumberCandidate(q) &&
      !isDigitsOnly(q);

    if (!canUseTypoLogic) return [];

    const singleVariants = buildTypoVariantsOnce(q);
    for (const variant of singleVariants) {
      const exactVariant = await fetchExactAppliance(variant);
      if (exactVariant) return [exactVariant];

      const rpcVariantMatches = await fetchModelsRpc(variant);
      if (rpcVariantMatches.length) {
        const rpcVariantAppliances = await fetchAppliancesByModels(rpcVariantMatches);
        if (rpcVariantAppliances.length) return uniqueByModel(rpcVariantAppliances);
      }

      const prefixVariantMatches = await fetchPrefixCandidates(variant);
      if (prefixVariantMatches.length) return uniqueByModel(prefixVariantMatches);
    }

    const doubleVariants = buildTypoVariantsTwice(q);
    for (const variant of doubleVariants) {
      const exactVariant = await fetchExactAppliance(variant);
      if (exactVariant) return [exactVariant];

      const rpcVariantMatches = await fetchModelsRpc(variant);
      if (rpcVariantMatches.length) {
        const rpcVariantAppliances = await fetchAppliancesByModels(rpcVariantMatches);
        if (rpcVariantAppliances.length) return uniqueByModel(rpcVariantAppliances);
      }

      const prefixVariantMatches = await fetchPrefixCandidates(variant);
      if (prefixVariantMatches.length) return uniqueByModel(prefixVariantMatches);
    }

    return [];
  }

  function logSearch(resultCount, hasResults) {
    fetch(SUPABASE_URL + "/search_logs", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "apikey": SUPABASE_KEY,
        "Prefer": "return=minimal"
      },
      body: JSON.stringify({
        searched_query: searchTerm,
        result_count: resultCount || 0,
        has_results: !!hasResults,
        source: "shopify-search"
      })
    }).catch(() => {});
  }

  const isExactPartQuery = isPartNumberCandidate(normalizedQuery);
  const isModelLikeQuery = looksLikeModelQuery(normalizedQuery) && !isExactPartQuery;

  if (isExactPartQuery) {
    hideModelInfo();
    return;
  }

  if (isModelLikeQuery) {
    showModelInfo("Ověřuji model…");
  } else {
    hideModelInfo();
  }

  try {
    const candidates = await fetchPossibleModelCandidates(normalizedQuery);

    if (candidates.length === 1) {
      window.location.replace(applianceUrl(candidates[0]));
      return;
    }

    if (candidates.length > 1) {
      window.location.replace("/pages/vyber-modelu?base=" + encodeURIComponent(normalizedQuery));
      return;
    }
  } catch (e) {
    console.error("Appliance redirect error:", e);
  }

  if (isModelLikeQuery) {
    const modelParts = await fetchPartsForModel(normalizedQuery);

    logSearch(
      modelParts.length > 0 ? modelParts.length : shopifyProductResultsCount,
      modelParts.length > 0 || shopifyProductResultsCount > 0
    );

    if (modelParts.length) {
      showModelInfo(
        '<b>Díly pro model:</b><ul style="margin:8px 0 0;">' +
          modelParts.map(x => {
            const pn = (x.part_number || "").trim();
            const title = (x.title || "").trim();
            const href = "/search?q=" + encodeURIComponent(pn);
            return "<li><a href=\"" + href + "\">" + pn + "</a>" + (title ? " – " + title : "") + "</li>";
          }).join("") +
          '</ul><div style="margin-top:8px;opacity:.7;font-size:.9em">Klikni na číslo dílu → otevře se e-shop vyhledávání pro ten díl.</div>'
      );
      return;
    }

    if (shopifyProductResultsCount > 0) {
      hideModelInfo();
      return;
    }

    showModelInfo(
      'Hledaný model nebyl bohužel nalezen. Pokud se pokoušíte o hledání modelu, je možné použít zástupný znak "?" místo neznámého znaku ze štítku.'
    );
    return;
  }

  logSearch(shopifyProductResultsCount, shopifyProductResultsCount > 0);
  hideModelInfo();
})();
</script>

        {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}

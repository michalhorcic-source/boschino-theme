{% comment %}
  Boschino custom footer
  - PC beze změny (media queries od 750px a 990px zůstávají)
  - Mobile změna:
      * logo vycentrované
      * "Informace" zarovnané vlevo
      * "Platební metody" zarovnané vlevo
      * FB/IG klidně na střed (sekce "Buďme ve spojení" centrovaně)
{% endcomment %}

{%- liquid
  assign boschino_facebook_link = 'https://www.facebook.com/people/Boschino/61585881047958/'
  assign boschino_instagram_link = 'https://www.instagram.com/boschino.cz/'

  assign logo_img = 'https://cdn.shopify.com/s/files/1/1001/0741/9979/files/logo_se_sloganem1_preview_rev_1.png?v=1769516494'

  assign fb_icon = 'https://cdn.shopify.com/s/files/1/1001/0741/9979/files/fb_ikona_preview_rev_1.png?v=1767956366'
  assign ig_icon = 'https://cdn.shopify.com/s/files/1/1001/0741/9979/files/ig_ikona_preview_rev_1.png?v=1767956366'

  assign pay_visa = 'https://cdn.shopify.com/s/files/1/1001/0741/9979/files/Visa_obrazek.jpg?v=1767956366'
  assign pay_mc = 'https://cdn.shopify.com/s/files/1/1001/0741/9979/files/Mastercard.jpg?v=1767956366'
  assign pay_comgate = 'https://cdn.shopify.com/s/files/1/1001/0741/9979/files/comgate.png?v=1767956366'
  assign pay_cod = 'https://cdn.shopify.com/s/files/1/1001/0741/9979/files/platba_na_dobirku_preview_rev_1.png?v=1767956366'
-%}


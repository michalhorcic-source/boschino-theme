  function updateActiveSuggestion(nextIndex) {
    const buttons = getSuggestionButtons();

    if (!buttons.length) {
      activeSuggestionIndex = -1;
      return;
    }

    if (nextIndex < 0) nextIndex = buttons.length - 1;
    if (nextIndex >= buttons.length) nextIndex = 0;

    activeSuggestionIndex = nextIndex;

    buttons.forEach(function (button, index) {
      const isActive = index === activeSuggestionIndex;
      button.classList.toggle('is-active', isActive);
      button.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });

    const activeButton = buttons[activeSuggestionIndex];
    if (activeButton) {
      activeButton.scrollIntoView({ block: 'nearest' });
      setGhostValue(activeButton.getAttribute('data-model-number') || '');
    } else {
      clearGhostValue();
    }
  }

  function selectSuggestionButton(button) {
    if (!button) return;
    const modelNumber = button.getAttribute('data-model-number');
    if (modelNumber) {
      selectApplianceModel(modelNumber);

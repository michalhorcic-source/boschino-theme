}

  function getSortConfig() {
    const sortBy = getCurrentSortValue();

    switch (sortBy) {
      case 'price-ascending':
        return { sortKey: 'PRICE', reverse: false };
      case 'price-descending':
        return { sortKey: 'PRICE', reverse: true };
      case 'title-ascending':
        return { sortKey: 'TITLE', reverse: false };
      case 'title-descending':
        return { sortKey: 'TITLE', reverse: true };
      case 'created-ascending':
        return { sortKey: 'CREATED', reverse: false };
      case 'created-descending':
        return { sortKey: 'CREATED', reverse: true };
      case 'best-selling':
        return { sortKey: 'BEST_SELLING', reverse: false };
      default:
        return { sortKey: 'CREATED', reverse: false };
    }
  }

  async function fetchAllCollectionProducts(handle) {
    const all = [];
    let hasNextPage = true;
    let cursor = null;
    const sortConfig = getSortConfig();

    while (hasNextPage) {
      const query = `
        query CollectionProductsForApplianceFilter($handle: String!, $cursor: String, $sortKey: ProductCollectionSortKeys, $reverse: Boolean) {
          collection(handle: $handle) {
            products(first: 250, after: $cursor, sortKey: $sortKey, reverse: $reverse) {
              pageInfo {
                hasNextPage
                endCursor
              }
              nodes {
                id
                handle
                title
                featuredImage {
                  url
                  altText
                }
                metafield(namespace: "custom", key: "termin_dodani") {
                  value
                }
                priceRange {
                  minVariantPrice {
                    amount
                    currencyCode
                  }
                }
                variants(first: 1) {
                  nodes {
                    id
                    availableForSale
                    quantityAvailable
                    currentlyNotInStock
                  }
                }
              }
            }
          }
        }
      `;

      const response = await fetch(SHOPIFY_GRAPHQL_URL, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Shopify-Storefront-Access-Token': SHOPIFY_STOREFRONT_TOKEN
        },
        body: JSON.stringify({
          query: query,
          variables: {
            handle: handle,
            cursor: cursor,
            sortKey: sortConfig.sortKey,
            reverse: sortConfig.reverse
          }
        })
      });

      if (!response.ok) {
        throw new Error('Nepodařilo se načíst produkty kolekce ze Shopify.');
      }

      const payload = await response.json();

      if (payload.errors && payload.errors.length) {
        throw new Error(payload.errors.map(function (item) {
          return item.message;
        }).join(', '));
      }

      const products = payload && payload.data && payload.data.collection && payload.data.collection.products;
      const nodes = products && products.nodes ? products.nodes : [];

      nodes.forEach(function (node) {
        const firstVariant = (node && node.variants && node.variants.nodes && node.variants.nodes[0]) || {};

        all.push({
          id: node && node.id ? node.id : '',
          handle: node && node.handle ? node.handle : '',
          title: node && node.title ? node.title : '',
          featuredImageUrl: node && node.featuredImage && node.featuredImage.url ? node.featuredImage.url : '',
          featuredImageAlt: node && node.featuredImage && node.featuredImage.altText ? node.featuredImage.altText : '',
          terminDodani: node && node.metafield && node.metafield.value ? node.metafield.value : '',
          priceAmount: node && node.priceRange && node.priceRange.minVariantPrice && node.priceRange.minVariantPrice.amount ? node.priceRange.minVariantPrice.amount : 0,
          priceCurrency: node && node.priceRange && node.priceRange.minVariantPrice && node.priceRange.minVariantPrice.currencyCode ? node.priceRange.minVariantPrice.currencyCode : 'CZK',
          variant: {
            id: firstVariant && firstVariant.id ? firstVariant.id : '',
            availableForSale: Boolean(firstVariant && firstVariant.availableForSale),
            quantityAvailable: firstVariant ? firstVariant.quantityAvailable : null,
            currentlyNotInStock: Boolean(firstVariant && firstVariant.currentlyNotInStock)
          }
        });
      });

      hasNextPage = Boolean(products && products.pageInfo && products.pageInfo.hasNextPage);
      cursor = products && products.pageInfo ? products.pageInfo.endCursor : null;
    }

    return all;
  }

  async function ensureCollectionProductsLoaded() {
    if (collectionProductsLoaded) return collectionProductsAll;

    try {
      collectionProductsAll = await fetchAllCollectionProducts(collectionHandle);
    } catch (error) {
      console.warn('Storefront fetch selhal, pouzivam DOM fallback pro kolekci.', error);
      collectionProductsAll = [];
    }

    if (!Array.isArray(collectionProductsAll) || !collectionProductsAll.length) {
      collectionProductsAll = hydrateCollectionProductsFromDom();
    }

    if (!Array.isArray(collectionProductsAll) || !collectionProductsAll.length) {
      throw new Error('Nepodarilo se nacist produkty kolekce ani z DOM fallbacku.');
    }

    collectionProductsLoaded = true;

    return collectionProductsAll;
  }

  async function fetchExactAppliance(modelValue) {
    const url =
      SUPABASE_REST_URL +
      '/appliances?select=model_norm,shopify_handle' +
      '&model_norm=eq.' + encodeURIComponent(modelValue) +
      '&limit=1';

    const res = await fetch(url, { headers: SUPABASE_HEADERS });
    if (!res.ok) return null;

    const data = await res.json();

    if (Array.isArray(data) && data.length > 0) {
      return {
        model_norm: (data[0].model_norm || '').trim(),
        shopify_handle: (data[0].shopify_handle || '').trim()
      };
    }

    return null;
  }

  async function fetchModelsRpc(q) {
    const res = await fetch(SEARCH_MODELS_RPC_URL, {
      method: 'POST',
      headers: SUPABASE_HEADERS,
      body: JSON.stringify({ q: String(q || '').toUpperCase() })
    });

    if (!res.ok) return [];
    const data = await res.json();

    if (!Array.isArray(data)) return [];

    return data
      .map(function (item) {
        if (typeof item === 'string') return item.trim();
        if (item && typeof item.model === 'string') return item.model.trim();
        return '';
      })
      .filter(Boolean);
  }

  async function fetchAppliancesByModels(models) {
    const uniqueModels = unique(
      (models || []).map(function (v) {
        return String(v || '').trim().toUpperCase();
      })
    ).slice(0, 50);

    if (!uniqueModels.length) return [];

    const conditions = uniqueModels
      .map(function (model) {
        return 'model_norm.eq.' + encodeURIComponent(model);
      })
      .join(',');

    const url =
      SUPABASE_REST_URL +
      '/appliances?select=model_norm,shopify_handle' +
      '&or=(' + conditions + ')' +
      '&order=model_norm.asc' +
      '&limit=50';

    const res = await fetch(url, { headers: SUPABASE_HEADERS });
    if (!res.ok) return [];

    const data = await res.json();
    if (!Array.isArray(data)) return [];

    return data
      .map(function (item) {
        return {
          model_norm: (item.model_norm || '').trim(),
          shopify_handle: (item.shopify_handle || '').trim()
        };
      })
      .filter(function (item) {
        return item.model_norm;
      });
  }

  async function fetchPrefixCandidates(rawValue) {
    const normalized = String(rawValue || '').trim().toUpperCase();
    if (!isShortModelPrefixCandidate(normalized)) return [];

    const url =
      SUPABASE_REST_URL +
      '/appliances?select=model_norm,shopify_handle' +
      '&model_norm=like.' + encodeURIComponent(normalized + '%') +
      '&order=model_norm.asc' +
      '&limit=20';

    const res = await fetch(url, { headers: SUPABASE_HEADERS });
    if (!res.ok) return [];

    const data = await res.json();
    if (!Array.isArray(data)) return [];

    return data
      .map(function (item) {
        return {
          model_norm: (item.model_norm || '').trim(),
          shopify_handle: (item.shopify_handle || '').trim()
        };
      })
      .filter(function (item) {
        return item.model_norm;
      });
  }

  async function fetchWildcardCandidates(rawValue) {
    const normalized = String(rawValue || '').trim().toUpperCase();
    const base = getModelBase(normalized);
    const prefix = getLookupPrefix(normalized);
    const knownEntries = getKnownPositionEntries(normalized);

    if (knownEntries.length < 2) return [];

    let url = SUPABASE_REST_URL + '/appliances?select=model_norm,shopify_handle';

    if (prefix.length >= 1) {
      url += '&model_norm=like.' + encodeURIComponent(prefix + '%');
    }

    url += '&order=model_norm.asc&limit=20';

    const res = await fetch(url, { headers: SUPABASE_HEADERS });
    if (!res.ok) return [];

    const data = await res.json();
    if (!Array.isArray(data)) return [];

    return data
      .map(function (item) {
        return {
          model_norm: (item.model_norm || '').trim(),
          shopify_handle: (item.shopify_handle || '').trim()
        };
      })
      .filter(function (item) {
        return item.model_norm;
      })
      .filter(function (item) {
        return modelMatchesKnownPositions(item.model_norm, base);
      });
  }

  async function fetchPossibleModelCandidates(rawValue) {
    const q = String(rawValue || '').trim().toUpperCase();
    if (!q) return [];

    if (isWildcardModelCandidate(q)) {
      return uniqueByModel(await fetchWildcardCandidates(q));
    }

    const exactMatch = await fetchExactAppliance(q);
    if (exactMatch) return [exactMatch];

    const rpcMatches = await fetchModelsRpc(q);
    if (rpcMatches.length) {
      const rpcAppliances = await fetchAppliancesByModels(rpcMatches);
      if (rpcAppliances.length) return uniqueByModel(rpcAppliances);
    }

    const prefixMatches = await fetchPrefixCandidates(q);
    if (prefixMatches.length) return uniqueByModel(prefixMatches);

    const canUseTypoLogic =
      !q.includes(' ') &&
      !q.includes('?') &&
      !isPartNumberCandidate(q) &&
      !isDigitsOnly(q);

    if (!canUseTypoLogic) return [];

    const singleVariants = buildTypoVariantsOnce(q);
    for (const variant of singleVariants) {
      const exactVariant = await fetchExactAppliance(variant);
      if (exactVariant) return [exactVariant];

      const rpcVariantMatches = await fetchModelsRpc(variant);
      if (rpcVariantMatches.length) {
        const rpcVariantAppliances = await fetchAppliancesByModels(rpcVariantMatches);
        if (rpcVariantAppliances.length) return uniqueByModel(rpcVariantAppliances);
      }

      const prefixVariantMatches = await fetchPrefixCandidates(variant);
      if (prefixVariantMatches.length) return uniqueByModel(prefixVariantMatches);
    }

    const doubleVariants = buildTypoVariantsTwice(q);
    for (const variant of doubleVariants) {
      const exactVariant = await fetchExactAppliance(variant);
      if (exactVariant) return [exactVariant];

      const rpcVariantMatches = await fetchModelsRpc(variant);
      if (rpcVariantMatches.length) {
        const rpcVariantAppliances = await fetchAppliancesByModels(rpcVariantMatches);
        if (rpcVariantAppliances.length) return uniqueByModel(rpcVariantAppliances);
      }

      const prefixVariantMatches = await fetchPrefixCandidates(variant);
      if (prefixVariantMatches.length) return uniqueByModel(prefixVariantMatches);
    }

    return [];
  }

  async function fetchCompatiblePartsForModel(modelNumber) {
    const response = await fetch(SUPABASE_URL + '/rest/v1/rpc/parts_for_model_only', {
      method: 'POST',
      headers: {
        apikey: SUPABASE_PUBLISHABLE_KEY,
        Authorization: 'Bearer ' + SUPABASE_PUBLISHABLE_KEY,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({
        p_model_norm: modelNumber
      })
    });

    if (!response.ok) {
      const errorText = await response.text();
      throw new Error('Supabase chyba: ' + response.status + ' ' + errorText);
    }

    return response.json();
  }

  function clearApplianceFilter(scrollToProducts) {
  selectedModel = '';
  typedValue = '';
  searchInput.value = '';
  currentApplianceProductGids = null;
  activeAvailabilityFilter = '';
  closeSuggestions();
  resetVisibleLimit();
  updateResetButtonVisibility();
  applyAllFilters('', { scrollToProducts: !!scrollToProducts });
}

  function applyFilteredProductGids(productGids, stateLabelText, scrollToProducts) {
    currentApplianceProductGids = Array.from(
      new Set((productGids || []).map(String).filter(Boolean))
    );

    resetVisibleLimit();
    applyAllFilters(stateLabelText || '', { scrollToProducts: !!scrollToProducts });
  }

  async function applyTypedPrefixFilter(items, rawQuery, requestId) {
    const normalizedQuery = String(rawQuery || '').trim().toUpperCase();

    if (!normalizedQuery || !Array.isArray(items) || !items.length) {
      currentApplianceProductGids = null;
      activeAvailabilityFilter = '';
      applyAllFilters('');
      return;
    }

    const matchingModels = items
      .map(function (item) {
        return String(item.model_norm || '').trim();
      })
      .filter(Boolean)
      .filter(function (model) {
        return model.toUpperCase().startsWith(normalizedQuery);
      });

    if (!matchingModels.length) {
      currentApplianceProductGids = [];
      activeAvailabilityFilter = '';
      resetVisibleLimit();
      applyAllFilters('Zobrazeny kompatibilní díly kategorie ' + collectionTitle + ' pro zadaný výraz: ' + rawQuery);
      return;
    }

    const partsResults = await Promise.all(
      matchingModels.map(function (model) {
        return fetchCompatiblePartsForModel(model).catch(function () {
          return [];
        });
      })
    );

    if (requestId !== activeRequestId) return;

    const compatibleGids = Array.from(
      new Set(
        partsResults
          .flat()
          .map(function (item) {
            return item.shopify_product_gid;
          })
          .filter(Boolean)
      )
    );

    applyFilteredProductGids(
      compatibleGids,
      'Zobrazeny kompatibilní díly kategorie ' + collectionTitle + ' pro zadaný výraz: ' + rawQuery,
      false
    );
  }

  async function runAutocomplete() {
    const query = (searchInput.value || '').trim();

    if (query.length < 3) {
      closeSuggestions();
      selectedModel = '';
      currentApplianceProductGids = null;
      activeAvailabilityFilter = '';
      resetVisibleLimit();

      applyAllFilters('');
      requestAnimationFrame(function () {
        searchInput.focus();
        const len = searchInput.value.length;
        searchInput.setSelectionRange(len, len);
      });

      return;
    }

    const requestId = ++activeRequestId;

    try {
      const items = await fetchPossibleModelCandidates(query);

      if (requestId !== activeRequestId) return;

      renderSuggestions(items);

      if (!Array.isArray(items) || !items.length) {
        selectedModel = '';
        currentApplianceProductGids = [];
        activeAvailabilityFilter = '';
        resetVisibleLimit();
        applyAllFilters('Zobrazeny kompatibilní díly kategorie ' + collectionTitle + ' pro zadaný výraz: ' + query);
        return;
      }

      const normalizedQuery = query.toUpperCase();
      const exactMatch = items.find(function (item) {
        return String(item.model_norm || '').toUpperCase() === normalizedQuery;
      });

      const firstItem = items[0];
      const firstModel = String((firstItem && firstItem.model_norm) || '').trim();

      if (exactMatch) {
        selectedModel = String(exactMatch.model_norm || '').trim();
        setGhostValue(selectedModel);

        const parts = await fetchCompatiblePartsForModel(selectedModel);

        if (requestId !== activeRequestId) return;

        const compatibleGids = Array.from(
          new Set(
            (parts || [])
              .map(function (item) {
                return item.shopify_product_gid;
              })
              .filter(Boolean)
          )
        );

        applyFilteredProductGids(
          compatibleGids,
          'Zobrazeny kompatibilní díly kategorie ' + collectionTitle + ' pro model: ' + selectedModel,
          false
        );
        return;
      }

      selectedModel = '';

      if (firstModel) {
        setGhostValue(firstModel);
      } else {
        clearGhostValue();
      }

      await applyTypedPrefixFilter(items, query, requestId);
    } catch (error) {
      if (requestId !== activeRequestId) return;
      suggestionsEl.innerHTML = '<div class="boschino-appliance-filter__empty">Nepodařilo se načíst našeptávání.</div>';
      suggestionsEl.hidden = false;
      activeSuggestionIndex = -1;
      clearGhostValue();
      console.error(error);
    }
  }

  async function selectApplianceModel(modelNumber) {
    try {
      const parts = await fetchCompatiblePartsForModel(modelNumber);

      const compatibleGids = Array.from(
        new Set(
          (parts || [])
            .map(function (item) {
              return item.shopify_product_gid;
            })
            .filter(Boolean)
        )
      );

      selectedModel = modelNumber;
      typedValue = modelNumber;
      searchInput.value = modelNumber;
      closeSuggestions();

      applyFilteredProductGids(
        compatibleGids,
        'Zobrazeny kompatibilní díly kategorie ' + collectionTitle + ' pro model: ' + modelNumber,
        true
      );
    } catch (error) {
      console.error(error);
    }
  }

  searchInput.addEventListener('input', function () {
  clearTimeout(debounceTimer);

  const selectionStart = searchInput.selectionStart || 0;
  const selectionEnd = searchInput.selectionEnd || 0;
  const upperValue = String(searchInput.value || '').toUpperCase();

  if (searchInput.value !== upperValue) {
    searchInput.value = upperValue;
    searchInput.setSelectionRange(selectionStart, selectionEnd);
  }

  typedValue = searchInput.value || '';
  const currentValue = typedValue.trim();

  if (!currentValue) {
    clearApplianceFilter(false);
    return;
  }

  if (currentValue.length < 3) {
    closeSuggestions();
    clearGhostValue();
    return;
  }

  clearGhostValue();
  resetVisibleLimit();
  debounceTimer = setTimeout(runAutocomplete, 180);
});

  searchInput.addEventListener('keydown', function (event) {
    const buttons = getSuggestionButtons();

    if (event.key === 'ArrowDown') {
      if (!buttons.length) return;
      event.preventDefault();
      updateActiveSuggestion(activeSuggestionIndex + 1);
      return;
    }

    if (event.key === 'ArrowUp') {
      if (!buttons.length) return;
      event.preventDefault();
      updateActiveSuggestion(activeSuggestionIndex - 1);
      return;
    }

    if (event.key === 'Enter') {
      event.preventDefault();

      if (activeSuggestionIndex >= 0 && buttons[activeSuggestionIndex]) {
        selectSuggestionButton(buttons[activeSuggestionIndex]);
        closeSuggestions();
        return;
      }

      closeSuggestions();
    }

    if (event.key === 'Escape') {
      closeSuggestions();
    }
  });

  searchInput.addEventListener('focus', function () {
    if ((searchInput.value || '').trim().length >= 3 && !selectedModel) {
      runAutocomplete();
    }
  });

  if (resetBtn) {
    resetBtn.addEventListener('click', function () {
      clearApplianceFilter(true);
    });
  }

  if (subfiltersEl) {
    subfiltersEl.addEventListener('click', function (event) {
      const button = event.target.closest('[data-availability-filter]');
      if (!button) return;

      const mode = button.getAttribute('data-availability-filter') || '';
      activeAvailabilityFilter = activeAvailabilityFilter === mode ? '' : mode;

      updateResetButtonVisibility();
      resetVisibleLimit();

      const currentText = stateTextEl ? stateTextEl.textContent : '';
      applyAllFilters(currentText, { scrollToProducts: true });
    });
  }

  document.addEventListener('click', function (event) {
    const suggestionBtn = event.target.closest('.boschino-appliance-filter__suggestion');

    if (suggestionBtn && suggestionsEl.contains(suggestionBtn)) {
      selectSuggestionButton(suggestionBtn);
      return;
    }

    if (!filterRoot.contains(event.target)) {
      closeSuggestions();
    }
  });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') {
      closeSuggestions();
    }
  });

  suggestionsEl.addEventListener('mousemove', function (event) {
    const button = event.target.closest('.boschino-appliance-filter__suggestion');
    if (!button) return;

    const buttons = getSuggestionButtons();
    const index = buttons.indexOf(button);
    if (index === -1) return;

    updateActiveSuggestion(index);
  });

  suggestionsEl.addEventListener('mouseleave', function () {
    activeSuggestionIndex = -1;

    const buttons = getSuggestionButtons();
    buttons.forEach(function (button) {
      button.classList.remove('is-active');
      button.setAttribute('aria-selected', 'false');
    });

    const firstButton = suggestionsEl.querySelector('.boschino-appliance-filter__suggestion');
    if (firstButton) {
      setGhostValue(firstButton.getAttribute('data-model-number') || '');
    } else {
      clearGhostValue();
    }
  });

  productGrid.addEventListener('click', function (event) {
    const minusBtn = event.target.closest('[data-qty-minus]');
    const plusBtn = event.target.closest('[data-qty-plus]');

    if (minusBtn) {
      const wrap = minusBtn.closest('[data-boschino-qty]');
      const input = wrap ? wrap.querySelector('[data-qty-input]') : null;
      if (!input || input.disabled) return;

      const min = Number(input.min || 1);
      const value = Number(input.value || min);
      input.value = String(Math.max(min, value - 1));
      return;
    }

    if (plusBtn) {
      const wrap = plusBtn.closest('[data-boschino-qty]');
      const input = wrap ? wrap.querySelector('[data-qty-input]') : null;
      if (!input || input.disabled) return;

      const min = Number(input.min || 1);
      const value = Number(input.value || min);
      input.value = String(Math.max(min, value + 1));
    }
  });

  productGrid.addEventListener('input', function (event) {
    const input = event.target.closest('[data-qty-input]');
    if (!input || input.disabled) return;

    const min = Number(input.min || 1);
    const value = Number(String(input.value || '').replace(/[^0-9]/g, ''));
    input.value = String(Number.isFinite(value) && value >= min ? value : min);
  });

  if (loadMoreBtn) {
    loadMoreBtn.addEventListener('click', function () {
      visibleLimit += PAGE_SIZE;
      const currentText = stateTextEl ? stateTextEl.textContent : '';
      applyAllFilters(currentText);
    });
  }

  if (backToFiltersBtn) {
  backToFiltersBtn.addEventListener('click', function () {
    scrollToFilters();
  });
}

window.addEventListener('scroll', updateBackToFiltersVisibility, { passive: true });
window.addEventListener('resize', updateBackToFiltersVisibility);

  if (sortSelect) {
    sortSelect.addEventListener('change', function () {
      const url = new URL(window.location.href);
      const value = this.value || '';

      if (value) {
        url.searchParams.set('sort_by', value);
      } else {
        url.searchParams.delete('sort_by');
      }

      try {
        sessionStorage.setItem(scrollAfterSortKey, '1');
      } catch (error) {}

      window.location.href = url.toString();
    });
  }

  setGridLoading(true);

  ensureCollectionProductsLoaded()
  .then(function () {
    return applyAllFilters('');
  })
  .then(function () {
    if (hasPendingSortScroll()) {
      runPendingSortScroll();
    } else {
      scrollToCategoriesIfNeeded();
    }
  })
  .catch(function (error) {
    console.error(error);
  })
  .finally(function () {
  setGridLoading(false);
  updateResetButtonVisibility();
  updateBackToFiltersVisibility();
});
})();
</script>

<script>
(function(){
  function getHeaderOffset(){
    var header = document.querySelector('.header, .section-header, #shopify-section-header, sticky-header');
    if (!header) return 12;
    var h = header.offsetHeight || 0;
    return Math.min(Math.max(h, 0), 140) + 12;
  }

  function findTarget(id){
    var el = document.getElementById(id);
    if (el) return el;

    if (id === 'product-grid-anchor'){
      return document.querySelector('#ProductGridContainer, #product-grid, #CollectionProductGrid, .product-grid, [data-product-grid]');
    }

    return null;
  }

  function scrollToEl(el){
    var y = window.scrollY + el.getBoundingClientRect().top - getHeaderOffset();
    window.scrollTo({ top: y, behavior: 'smooth' });
  }

  function setActive(id){
    document.querySelectorAll('.bsh-pill').forEach(function(link){
      var active = link.getAttribute('data-scroll') === id;
      link.classList.toggle('is-active', active);

      if (active) {
        link.setAttribute('aria-current', 'location');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  document.addEventListener('click', function(e){
    var a = e.target.closest('.bsh-pill');
    if (!a) return;

    var targetId = a.getAttribute('data-scroll');
    if (!targetId) return;

    var target = findTarget(targetId);

    if (targetId === 'product-grid-anchor') {
      var grid =
        document.querySelector('#ProductGridContainer') ||
        document.querySelector('#product-grid') ||
        document.querySelector('#CollectionProductGrid') ||
        document.querySelector('.product-grid') ||
        document.querySelector('[data-product-grid]');

      if (grid) target = grid;
    }

    if (!target) {
      e.preventDefault();
      a.classList.add('is-disabled');
      a.setAttribute('aria-disabled', 'true');
      return;
    }

    e.preventDefault();
    scrollToEl(target);
    setActive(targetId);
    history.replaceState(null, '', '#' + targetId);
  }, { passive: false });

  window.addEventListener('load', function(){
    var hash = (location.hash || '').replace('#', '').trim();
    if (!hash) return;

    var target = findTarget(hash);

    if (hash === 'product-grid-anchor') {
      var grid =
        document.querySelector('#ProductGridContainer') ||
        document.querySelector('#product-grid') ||
        document.querySelector('#CollectionProductGrid') ||
        document.querySelector('.product-grid') ||
        document.querySelector('[data-product-grid]');

      if (grid) target = grid;
    }

    if (!target) return;

    setTimeout(function(){
      scrollToEl(target);
      setActive(hash);
    }, 50);
  });

  window.addEventListener('scroll', function(){
    var candidates = ['product-grid-anchor', 'enr', 'related'];
    var y = window.scrollY + 160;
    var best = null;

    for (var i = 0; i < candidates.length; i++){
      var id = candidates[i];
      var el = (id === 'product-grid-anchor')
        ? (document.querySelector('#ProductGridContainer, #product-grid, #CollectionProductGrid, .product-grid, [data-product-grid]') || document.getElementById('product-grid-anchor'))
        : findTarget(id);

      if (!el) continue;

      var top = el.getBoundingClientRect().top + window.scrollY;
      if (top <= y) best = id;
    }

    if (best) setActive(best);
  }, { passive: true });
})();
</script>


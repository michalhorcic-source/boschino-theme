  function syncSubfilterCounts() {
    if (!subfiltersEl || !collectionProductsAll.length) return;

    const allowedSet = getCurrentAllowedSet();
    let inCount = 0;
    let outCount = 0;

    collectionProductsAll.forEach(function (product) {
      const gid = String(product.id || '');
      if (allowedSet && !allowedSet.has(gid)) return;

      const availability = getAvailabilityMeta(product);
      if (availability.filterValue === 'in') inCount += 1;
      if (availability.filterValue === 'out') outCount += 1;
    });

    const inEl = subfiltersEl.querySelector('[data-availability-count="in"]');
    const outEl = subfiltersEl.querySelector('[data-availability-count="out"]');

    if (inEl) inEl.textContent = String(inCount);
    if (outEl) outEl.textContent = String(outCount);

    subfiltersEl.hidden = false;
  }

  async function applyAllFilters(modelLabelText, options) {
    options = options || {};
    setGridLoading(true);

    try {
      await ensureCollectionProductsLoaded();
    } catch (error) {
      console.error(error);
      setGridLoading(false);
      return;
    }

    if (paginationEl) {
      paginationEl.style.display = 'none';
    }

    const allowedSet = getCurrentAllowedSet();

    const matchedProducts = collectionProductsAll.filter(function (product) {
      const gid = String(product.id || '');
      const availability = getAvailabilityMeta(product).filterValue;

      let matchesAppliance = true;
      let matchesAvailability = true;

      if (allowedSet) {
        matchesAppliance = allowedSet.has(gid);
      }

      if (activeAvailabilityFilter === 'in') {
        matchesAvailability = availability === 'in';
      } else if (activeAvailabilityFilter === 'out') {
        matchesAvailability = availability === 'out';
      }

      return matchesAppliance && matchesAvailability;
    });

    const sortedProducts = sortMatchedProducts(matchedProducts);
    renderFilteredGrid(sortedProducts.slice(0, visibleLimit));

    if (stateEl) {
      stateEl.hidden = false;
    }

    if (stateTextEl) {
      if (allowedSet) {
        stateTextEl.textContent = modelLabelText || '';
      } else if (activeAvailabilityFilter) {
        stateTextEl.textContent = 'Filtr dostupnosti: ' + getAvailabilityLabel(activeAvailabilityFilter);
      } else {
        stateTextEl.textContent = 'Zobrazeny všechny produkty v kategorii ' + collectionTitle;
      }
    }

    if (subfiltersEl) {
      subfiltersEl.hidden = false;
    }

    syncSubfilterCounts();
    syncSubfilterActiveState();
    updateVisibleCount(sortedProducts.length);
    updateLoadMoreVisibility(sortedProducts.length);
    setGridLoading(false);
    updateResetButtonVisibility();

    if (options.scrollToProducts) {
      requestAnimationFrame(function () {
        scrollToFilteredProducts();
      });
    }
    requestAnimationFrame(function () {
  updateBackToFiltersVisibility();
});
  }

  function getSuggestionButtons() {

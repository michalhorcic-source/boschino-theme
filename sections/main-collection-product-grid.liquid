                      {%- else -%}
                        Na objednávku
                      {%- endif -%}
                    </span>
                    <span class="inventory-tooltip">
                      {%- if is_neznamo -%}
                        Termín dodání upřesníme po Vašem objednání.
                      {%- else -%}
                        Tyto díly obvykle stíháme dodat do týdne od Vaší objednávky.
                      {%- endif -%}
                    </span>
                  </span>
                </div>
              </div>
            </div>

            <div class="boschino-actions">
              <form method="post" action="/cart/add" class="boschino-card-buy" data-boschino-card-buy>
                <input type="hidden" name="id" value="{{ variant.id }}">

                <div class="boschino-quantity" data-boschino-qty>
                  <button type="button" class="boschino-minus" data-qty-minus aria-label="Odebrat 1 ks">−</button>

                  <input
                    type="number"
                    name="quantity"
                    value="1"
                    min="1"
                    step="1"
                    inputmode="numeric"
                    pattern="[0-9]*"
                    aria-label="Počet kusů"
                    data-qty-input
                  >

                  <button type="button" class="boschino-plus" data-qty-plus aria-label="Přidat 1 ks">+</button>

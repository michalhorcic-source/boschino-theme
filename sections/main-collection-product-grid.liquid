                  <div class="boschino-cta__cart">
                    <button type="submit" class="boschino-cta__btn" aria-label="Objednat">
                      <svg class="boschino-cart-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-1.99.9-1.99 2S15.9 22 17 22s2-.9 2-2-.9-2-2-2zM7.2 6h13.4c.8 0 1.4.7 1.2 1.5l-1.6 7.2c-.2.7-.8 1.3-1.6 1.3H8.1c-.7 0-1.4-.5-1.6-1.2L4.3 3H2V1h3.7c.6 0 1.1.4 1.2 1l.3 2z"></path>
                      </svg>
                    </button>
                  </div>
                </div>
              </form>
            </div>

          </div>
        </div>
      </div>
    </li>
  {%- endif -%}
{%- endfor -%}

  {%- comment -%} 3) NELZE OBJEDNAT (červené) {%- endcomment -%}
{%- for product in collection.products -%}
  {%- assign variant = product.selected_or_first_available_variant -%}
  {%- assign qty = variant.inventory_quantity | default: 0 -%}
  {%- assign policy = variant.inventory_policy -%}
  {%- assign termin_raw = product.metafields.custom.termin_dodani.value | default: '' -%}
  {%- assign termin_norm = termin_raw | strip | downcase -%}
  {%- assign is_vyrazeno = false -%}
  {%- assign show_out = false -%}

  {%- if termin_norm == 'vyrazeno' or termin_norm == 'vyřazeno' -%}
    {%- assign is_vyrazeno = true -%}
  {%- endif -%}

  {%- comment -%}
    PRIORITA:
    1) qty > 0                => Skladem
    2) qty <= 0 + continue    => Na objednávku
    3) qty <= 0 + !continue   => Nelze objednat / Prodej ukončen

    metafield "vyřazeno" smí rozhodovat jen pokud qty <= 0
  {%- endcomment -%}

  {%- if qty <= 0 and policy != 'continue' -%}
    {%- assign show_out = true -%}
  {%- endif -%}

  {%- if qty <= 0 and is_vyrazeno -%}
    {%- assign show_out = true -%}
  {%- endif -%}

  {%- if show_out -%}
    <li
  class="grid__item"
  data-product-gid="gid://shopify/Product/{{ product.id }}"
  data-availability="out"
>
      <div class="card-wrapper product-card-wrapper">

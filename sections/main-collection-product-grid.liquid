                <div class="card-information">
                  {%- render 'price', product: product, use_variant: true, show_badges: false -%}

                  <div class="boschino-stock">
  <span class="inventory-status-with-tooltip" tabindex="0">
    <span class="boschino-stock__status boschino-stock__status--in">
      {%- if qty == 1 -%}
        Poslední kus skladem
      {%- else -%}
        Skladem
      {%- endif -%}
    </span>
    <span class="inventory-tooltip">

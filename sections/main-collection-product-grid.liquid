{% render 'bsh-collection-jsonld', collection: collection %}

{%- style -%}
/* =========================
   BOSCHINO – Collection UI (STEJNÝ VZOR JAKO SEARCH)
   ========================= */

.section-{{ section.id }}-padding{
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;

  /* =====================================================
     BOSCHINO DESIGN SYSTEM – COLLECTION / SEARCH UI
     ===================================================== */

  /* Brand */
  --bosch-blue: #2a3885;
  --bosch-red:  #e20015;

  /* Background */
  --ui-bg: #E5E7E8;          /* hlavní katalogové pozadí */

  /* Text */
  --text-strong: rgba(0,0,0,0.88);
  --text-soft:   rgba(0,0,0,0.62);

  /* Borders & Shadows (oficiálnější, méně e-shopový look) */
  --border-soft:  rgba(0,0,0,0.18);
  --shadow-soft:  0 4px 10px rgba(0,0,0,0.06);
  --shadow-hover: 0 8px 18px rgba(0,0,0,0.10);

  /* Bottom accent */
  --bottom-dark: #255da0;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

/* Jemné pozadí sekce */
.section-{{ section.id }}-padding.gradient {
  background: var(--ui-bg) !important;
}

/* Ultra wide (jako kolekce/search) */
.section-{{ section.id }}-padding .page-width {
  max-width: none !important;
  width: min(1800px, calc(100vw - 56px)) !important;
  padding-left: 28px !important;
  padding-right: 28px !important;
}
@media screen and (min-width: 1600px) {
  .section-{{ section.id }}-padding .page-width {
    width: min(2100px, calc(100vw - 64px)) !important;
    padding-left: 32px !important;
    padding-right: 32px !important;
  }
}

/* Layout pro vertical facets */
@media screen and (min-width: 990px) {
  .section-{{ section.id }}-padding .facets-vertical {
    grid-template-columns: 260px 1fr !important;
    column-gap: 28px !important;
  }
}

/* Grid spacing
   duplicita fix: když na desktopu přepínáme #product-grid na CSS GRID,
   tak gap na .boschino-product-grid necháme jen pro <990px */
@media screen and (max-width: 989px) {
  .section-{{ section.id }}-padding .boschino-product-grid {
    gap: 22px !important;
  }
}
@media screen and (min-width: 750px) and (max-width: 989px) {
  .section-{{ section.id }}-padding .boschino-product-grid {
    gap: 28px !important;
  }
}

/* =========================
   FORCE 4 COLUMNS (desktop)
   – přepneme Dawn flex grid na CSS GRID
   ========================= */
@media screen and (min-width: 990px) {
  .section-{{ section.id }}-padding #product-grid {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    column-gap: 28px !important;
    row-gap: 28px !important;
  }

  /* Dawn má na .grid__item width – to musíme vypnout */
  .section-{{ section.id }}-padding #product-grid > .grid__item,
  .section-{{ section.id }}-padding #product-grid > li.grid__item {
    width: auto !important;
    max-width: none !important;
    flex: initial !important;
  }

  /* pojistka: ať se content vedle filtrů může zmenšit */
  .section-{{ section.id }}-padding .product-grid-container {
    min-width: 0 !important;
  }
}

/* =========================
   FILTRY – větší písmo + checkbox styl (stejné jako search)
   ========================= */
.section-{{ section.id }}-padding .facets__heading,
.section-{{ section.id }}-padding .facets__summary,
.section-{{ section.id }}-padding .facets__title {
  font-size: 16px !important;
  font-weight: 900 !important;
  letter-spacing: 0 !important;
  text-transform: none !important;
}

.section-{{ section.id }}-padding .facets__item label,
.section-{{ section.id }}-padding .facet-checkbox {
  font-size: 16px !important;
  font-weight: 800 !important;
  color: rgba(0,0,0,0.84) !important;
  text-transform: none !important;
}

/* schovej dawn checkbox ikonky */
.section-{{ section.id }}-padding .facets label.facet-checkbox .facet-checkbox__checkbox,
.section-{{ section.id }}-padding .facets label.facet-checkbox .facet-checkbox__checkbox-icon,
.section-{{ section.id }}-padding .facets label.facet-checkbox .icon-checkmark,
.section-{{ section.id }}-padding .facets label.facet-checkbox svg.icon-checkmark,
.section-{{ section.id }}-padding .facets label.facet-checkbox .icon-square,
.section-{{ section.id }}-padding .facets label.facet-checkbox svg.icon-square,
.section-{{ section.id }}-padding .facets label.facet-checkbox .icon-checkbox,
.section-{{ section.id }}-padding .facets label.facet-checkbox svg.icon-checkbox,
.section-{{ section.id }}-padding .facets label.facet-checkbox > input[type="checkbox"] + svg{
  display: none !important;
}

/* řádek klikací + prostor pro box */
.section-{{ section.id }}-padding .facets label.facet-checkbox{
  position: relative !important;
  display: flex !important;
  align-items: center !important;
  gap: 10px !important;
  cursor: pointer !important;
  padding-left: 34px !important;
}

/* input funkční, neviditelný */
.section-{{ section.id }}-padding .facets label.facet-checkbox > input[type="checkbox"]{
  position: absolute !important;
  opacity: 0 !important;
  width: 1px !important;
  height: 1px !important;
  margin: 0 !important;
  padding: 0 !important;
}

/* černý rámeček */
.section-{{ section.id }}-padding .facets label.facet-checkbox::before{
  content: "" !important;
  position: absolute !important;
  left: 0 !important;
  top: 50% !important;
  transform: translateY(-50%) !important;
  width: 22px !important;
  height: 22px !important;
  border: 3px solid #000 !important;
  background: #fff !important;
  box-sizing: border-box !important;
  pointer-events: none !important;
}

/* fajfka PNG */
.section-{{ section.id }}-padding .facets label.facet-checkbox:has(> input[type="checkbox"]:checked)::after{
  content: "" !important;
  position: absolute !important;
  pointer-events: none !important;
  left: 11px !important;
  top: 50% !important;
  width: 48px !important;
  height: 36px !important;
  background-repeat: no-repeat !important;
  background-position: center !important;
  background-size: contain !important;
  background-image: url("https://cdn.shopify.com/s/files/1/1001/0741/9979/files/fajfka_png.png?v=1769163383") !important;
  transform: translate(-35%, -65%) !important;
}

/* 4) Top bar (Řadit + počet): enterprise styl */
.section-{{ section.id }}-padding .facets-wrapper{
  background: transparent !important;
  border: 0 !important;
  padding: 0 !important;
  border-radius: 0 !important;
}

.section-{{ section.id }}-padding .facets-vertical-form{
  background:#f6f8fb !important;
  border:1px solid rgba(0,0,0,0.08) !important;
  padding:10px 14px !important;
  border-radius:0 !important;
}

.section-{{ section.id }}-padding .facets-vertical-sort .facets-vertical-form{
  box-shadow:none !important;
  border-left:6px solid var(--bosch-blue) !important;
  background:rgba(255,255,255,0.96) !important;
  backdrop-filter:blur(6px);
}

/* 4) Pojistka: grid a karty nechť jsou v nižší vrstvě */
.section-{{ section.id }}-padding #product-grid{
  position: relative !important;
  z-index: 1 !important;
}
.section-{{ section.id }}-padding #product-grid .card-wrapper{
  position: relative !important;
  z-index: 1 !important;
}
/* skladovost pod cenou v kartě */
.section-{{ section.id }}-padding #product-grid .boschino-stock{
  margin-top: 6px !important;
  font-size: 13px !important;
  font-weight: 800 !important;
  color: rgba(0,0,0,0.62) !important;
}

.section-{{ section.id }}-padding #product-grid .boschino-stock__status{
  display: inline-flex !important;
  align-items: center !important;
  gap: 6px !important;
}

/* malá tečka jako u detailu */
.section-{{ section.id }}-padding #product-grid .boschino-stock__status::before{
  content: "" !important;
  width: 8px !important;
  height: 8px !important;
  border-radius: 999px !important;
  display: inline-block !important;
  background: #2ecc71 !important;
}

/* stavy */
.section-{{ section.id }}-padding #product-grid .boschino-stock__status--in::before{
  background: #2ecc71 !important;
}
.section-{{ section.id }}-padding #product-grid .boschino-stock__status--order::before{
  background: #f1c40f !important;
}
.section-{{ section.id }}-padding #product-grid .boschino-stock__status--out::before{
  background: #e74c3c !important;
}

/* tooltip bubliny skladovosti – stejné jako na produktu */
.section-{{ section.id }}-padding #product-grid .inventory-status-with-tooltip {
  position: relative;
  display: inline-flex !important;
  align-items: center !important;
  gap: 6px !important;
  cursor: help;
}

.section-{{ section.id }}-padding #product-grid .inventory-status-with-tooltip .inventory-tooltip {
  position: absolute;
  left: 0;
  bottom: calc(100% + 10px);
  z-index: 30;
  min-width: 220px;
  max-width: 280px;
  padding: 10px 12px;
  border-radius: 8px;
  background: rgba(28, 28, 28, 0.96);
  color: #fff;
  font-size: 12px;
  line-height: 1.45;
  font-weight: 500;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
  opacity: 0;
  visibility: hidden;
  transform: translateY(6px);
  transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
  pointer-events: none;
}

.section-{{ section.id }}-padding #product-grid .inventory-status-with-tooltip .inventory-tooltip::after {
  content: "";
  position: absolute;
  left: 18px;
  top: 100%;
  border-width: 6px;
  border-style: solid;
  border-color: rgba(28, 28, 28, 0.96) transparent transparent transparent;
}

.section-{{ section.id }}-padding #product-grid .inventory-status-with-tooltip:hover .inventory-tooltip,
.section-{{ section.id }}-padding #product-grid .inventory-status-with-tooltip:focus .inventory-tooltip,
.section-{{ section.id }}-padding #product-grid .inventory-status-with-tooltip:focus-within .inventory-tooltip {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

@media screen and (max-width: 749px) {
  .section-{{ section.id }}-padding #product-grid .inventory-status-with-tooltip .inventory-tooltip {
    left: 0;
    right: auto;
    min-width: 200px;
    max-width: 240px;
  }
}


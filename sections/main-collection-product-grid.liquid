<script>
(function () {
  const sectionId = '{{ section.id }}';
  const collectionHandle = {{ collection.handle | json }};
  const collectionTitle = {{ collection.title | json }};

  const searchInput = document.getElementById('boschino-appliance-search-' + sectionId);
  const suggestionsEl = document.getElementById('boschino-appliance-suggestions-' + sectionId);
  const filterRoot = document.getElementById('boschino-appliance-filter-' + sectionId);
  const stateEl = document.getElementById('boschino-appliance-filter-state-' + sectionId);
  const stateTextEl = document.getElementById('boschino-appliance-filter-state-text-' + sectionId);
  const resetBtn = document.getElementById('boschino-appliance-filter-reset-' + sectionId);
  const ghostEl = document.getElementById('boschino-appliance-ghost-' + sectionId);
  const subfiltersEl = document.getElementById('boschino-appliance-subfilters-' + sectionId);
  const backToFiltersBtn = document.getElementById('boschino-back-to-filters-' + sectionId);
  const productGrid = document.getElementById('product-grid');
  const loadMoreWrap = document.getElementById('boschino-load-more-wrap-' + sectionId);
  const loadMoreBtn = document.getElementById('boschino-load-more-' + sectionId);
  const countDesktop = document.getElementById('ProductCountDesktop');
  const paginationEl = document.querySelector('.pagination-wrapper');
  const gridLoadingEl = document.getElementById('boschino-grid-loading-' + sectionId);
  const inlineLoadingEl = document.getElementById('boschino-inline-loading-' + sectionId);
  const sortSelect = document.getElementById('SortBy');

  const PAGE_SIZE = 32;
  const scrollAfterSortKey = 'boschino-scroll-after-sort-' + sectionId;
  const autoScrollStorageKey = 'boschino-collection-seen:' + window.location.pathname;

  if (!searchInput || !suggestionsEl || !filterRoot || !productGrid || !collectionHandle || !ghostEl) return;

  const SUPABASE_URL = 'https://hbntpqlpcrodrhfjxhpv.supabase.co';
  const SUPABASE_PUBLISHABLE_KEY = 'sb_publishable_py5U4zoYoBusjy_rngRuWg_IcZ6o-AV';
  const SHOPIFY_STOREFRONT_TOKEN = '7ca8d15c338fa86a89f0c7f4670ba6b2';
  const SHOPIFY_GRAPHQL_URL = window.location.origin + '/api/2024-10/graphql.json';

  let collectionProductsAll = [];
  let collectionProductsLoaded = false;
  let activeRequestId = 0;
  let debounceTimer = null;
  let currentApplianceProductGids = null;
  let activeAvailabilityFilter = '';
  let selectedModel = '';
  let activeSuggestionIndex = -1;
  let typedValue = '';
  let visibleLimit = PAGE_SIZE;

  const SUPABASE_REST_URL = SUPABASE_URL + '/rest/v1';
  const SEARCH_MODELS_RPC_URL = SUPABASE_REST_URL + '/rpc/search_models';

  const SUPABASE_HEADERS = {
    apikey: SUPABASE_PUBLISHABLE_KEY,
    Authorization: 'Bearer ' + SUPABASE_PUBLISHABLE_KEY,
    'Content-Type': 'application/json'
  };

  const TYPO_RULES = [
    { from: '0', to: 'O' },
    { from: 'O', to: '0' },
    { from: '1', to: 'I' },
    { from: 'I', to: '1' },
    { from: '8', to: 'B' },
    { from: 'B', to: '8' },
    { from: '5', to: 'S' },
    { from: 'S', to: '5' },
    { from: '2', to: 'Z' },
    { from: 'Z', to: '2' },
    { from: 'VV', to: 'W' },
    { from: 'W', to: 'VV' }
  ];

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function normalizeText(value) {
    return String(value || '').trim().toLowerCase();
  }

  function unique(values) {
    return [...new Set((values || []).filter(Boolean))];
  }

  function uniqueByModel(items) {
    return (items || []).filter(function (item, index, arr) {
      return arr.findIndex(function (x) {
        return String(x.model_norm || '').trim() === String(item.model_norm || '').trim();
      }) === index;
    });
  }

  function getNumericIdFromGid(gid) {
    return String(gid || '').split('/').pop() || '';
  }

  function formatMoney(amount, currencyCode) {
    const numericAmount = Number(amount || 0);
    const currency = currencyCode || 'CZK';

    try {
      return new Intl.NumberFormat('cs-CZ', {
        style: 'currency',
        currency: currency,
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(numericAmount);
    } catch (error) {
      return numericAmount.toFixed(2).replace('.', ',') + ' Kč';
    }
  }

  function parseMoneyToNumber(value) {
    const normalized = String(value || '')
      .replace(/\s+/g, '')
      .replace(/[^\d,.-]/g, '')
      .replace(/\.(?=\d{3}(?:[,.]|$))/g, '')
      .replace(',', '.');

    const numericValue = Number(normalized);
    return Number.isFinite(numericValue) ? numericValue : 0;
  }

  function getProductHandleFromUrl(url) {
    const match = String(url || '').match(/\/products\/([^/?#]+)/);
    return match ? decodeURIComponent(match[1]) : '';
  }

  function hydrateCollectionProductsFromDom() {
    if (!productGrid) return [];

    return Array.from(productGrid.querySelectorAll('.grid__item[data-product-gid]'))
      .map(function (item) {
        const detailLink =
          item.querySelector('.card__heading a') ||
          item.querySelector('.full-unstyled-link') ||
          item.querySelector('.boschino-cta__detail');
        const image = item.querySelector('.card__media img');
        const priceEl = item.querySelector('.price-item--regular');
        const stockStatusEl = item.querySelector('.boschino-stock__status');
        const variantInput =
          item.querySelector('form[action="/cart/add"] input[name="id"]') ||
          item.querySelector('form[action*="/cart/add"] input[name="id"]');

        const stockLabel = normalizeText(stockStatusEl ? stockStatusEl.textContent : '');
        const stockLabelPlain = stockLabel
          ? stockLabel.normalize('NFD').replace(/[\u0300-\u036f]/g, '')
          : '';
        let terminDodani = '';
        let availableForSale = false;
        let quantityAvailable = 0;
        let currentlyNotInStock = false;

        if (stockLabel.includes('skladem') || stockLabelPlain.includes('posledni kus')) {
          availableForSale = true;
          quantityAvailable = 1;
        } else if (stockLabelPlain.includes('upresneni po objednani')) {
          terminDodani = 'neznamo';
          availableForSale = true;
          currentlyNotInStock = true;
        } else if (stockLabelPlain.includes('na objednavku')) {
          availableForSale = true;
          currentlyNotInStock = true;
        } else {
          terminDodani = 'vyrazeno';
        }

        return {
          id: item.getAttribute('data-product-gid') || '',
          handle: detailLink ? getProductHandleFromUrl(detailLink.getAttribute('href')) : '',
          title: detailLink ? String(detailLink.textContent || '').trim() : '',
          featuredImageUrl: image ? image.getAttribute('src') || '' : '',
          featuredImageAlt: image ? image.getAttribute('alt') || '' : '',
          terminDodani: terminDodani,
          priceAmount: priceEl ? parseMoneyToNumber(priceEl.textContent) : 0,
          priceCurrency: 'CZK',
          variant: {
            id: variantInput ? variantInput.value : '',
            availableForSale: availableForSale,
            quantityAvailable: quantityAvailable,
            currentlyNotInStock: currentlyNotInStock
          }
        };
      })
      .filter(function (item) {
        return item.id && item.handle;
      });
  }

  function getCurrentSortValue() {
    if (sortSelect && sortSelect.value) return sortSelect.value;
    return new URLSearchParams(window.location.search).get('sort_by') || 'created-ascending';
  }

  function hasPendingSortScroll() {
    try {
      return sessionStorage.getItem(scrollAfterSortKey) === '1';
    } catch (error) {
      return false;
    }
  }

  function runPendingSortScroll() {
    if (!hasPendingSortScroll()) return;

    try {
      sessionStorage.removeItem(scrollAfterSortKey);
    } catch (error) {}

    requestAnimationFrame(function () {
      scrollToFilteredProducts();
    });
  }

  function getShouldAutoScrollOnLoad() {
    try {
      const alreadySeen = localStorage.getItem(autoScrollStorageKey) === '1';
      localStorage.setItem(autoScrollStorageKey, '1');
      return alreadySeen;
    } catch (error) {
      return false;
    }
  }

  function scrollToFilteredProducts() {
    const target =
      document.getElementById('main-collection-filters') ||
      productGrid ||
      document.getElementById('ProductGridContainer');

    if (!target) return;

    const top = target.getBoundingClientRect().top + window.pageYOffset - 16;

    window.scrollTo({
      top: Math.max(0, top),
      behavior: 'smooth'
    });
  }

  function scrollToCategoriesIfNeeded() {
    if (!getShouldAutoScrollOnLoad()) return;

    const relatedHeading = Array.from(
      document.querySelectorAll('h1, h2, h3, h4, h5, h6, p, div, span')
    ).find(function (el) {
      return (el.textContent || '').trim() === 'Související kategorie Boschino';
    });

    const target =
      relatedHeading ||
      document.getElementById('main-collection-filters') ||
      document.getElementById('ProductGridContainer');

    if (!target) return;

    requestAnimationFrame(function () {
      const top = target.getBoundingClientRect().top + window.pageYOffset - 16;

      window.scrollTo({
        top: Math.max(0, top),
        behavior: 'smooth'
      });
    });
  }

  function setGhostValue(fullModel) {
    const typed = String(typedValue || '');
    const model = String(fullModel || '');

    if (!model || !typed) {
      clearGhostValue();
      return;
    }

    const typedUpper = typed.toUpperCase();
    const modelUpper = model.toUpperCase();

    if (!modelUpper.startsWith(typedUpper)) {
      clearGhostValue();
      return;
    }

    const prefix = model.slice(0, typed.length);
    const suffix = model.slice(typed.length);

    if (!suffix) {
      clearGhostValue();
      return;
    }

    ghostEl.innerHTML =
      '<span class="boschino-appliance-filter__ghost-typed">' + escapeHtml(prefix) + '</span>' +
      '<span class="boschino-appliance-filter__ghost-suffix">' + escapeHtml(suffix) + '</span>';

    ghostEl.style.display = 'block';
  }

  function clearGhostValue() {
    ghostEl.innerHTML = '';
    ghostEl.style.display = 'none';
  }

  function closeSuggestions() {
    suggestionsEl.hidden = true;
    suggestionsEl.innerHTML = '';
    activeSuggestionIndex = -1;
    clearGhostValue();
  }

  function resetVisibleLimit() {
    visibleLimit = PAGE_SIZE;
  }

  function updateLoadMoreVisibility(totalMatched) {
    if (!loadMoreWrap) return;
    loadMoreWrap.hidden = !(totalMatched > visibleLimit);
  }

  function getAvailabilityLabel(mode) {
    if (mode === 'in') return 'Skladem';
    if (mode === 'out') return 'Není skladem';
    return '';
  }

  function getCurrentAllowedSet() {
    if (!Array.isArray(currentApplianceProductGids)) return null;
    return new Set(currentApplianceProductGids.map(String));
  }

  function updateVisibleCount(total) {
    const nextText = 'Počet produktů: ' + total;
    const targets = Array.from(
      document.querySelectorAll('#ProductCountDesktop, #ProductCount, .mobile-facets__count')
    );

    if (!targets.length) {
      if (countDesktop) countDesktop.textContent = nextText;
      return;
    }

    targets.forEach(function (el) {
      el.textContent = nextText;
    });
  }

  function setGridLoading(isLoading) {
    if (gridLoadingEl) {
      gridLoadingEl.hidden = !isLoading;
    }

    if (inlineLoadingEl) {
      inlineLoadingEl.hidden = !isLoading;
    }

    if (loadMoreBtn) {
      loadMoreBtn.disabled = isLoading;
    }
  }

  function updateResetButtonVisibility() {
  if (!resetBtn) return;

  const hasModelFilter =
    Array.isArray(currentApplianceProductGids) ||
    String(typedValue || '').trim().length >= 3;

  const hasAvailabilityFilter = !!activeAvailabilityFilter;

  resetBtn.hidden = !(hasModelFilter || hasAvailabilityFilter);
}

  function syncSubfilterActiveState() {
    if (!subfiltersEl) return;

    const buttons = Array.from(subfiltersEl.querySelectorAll('[data-availability-filter]'));
    buttons.forEach(function (button) {
      const mode = button.getAttribute('data-availability-filter') || '';
      button.classList.toggle('is-active', mode === activeAvailabilityFilter);
    });
  }

  function isPartNumberCandidate(value) {
    return /^(?:00|1|2)\d{6}$/.test(String(value || '').trim());
  }

  function isDigitsOnly(value) {
    return /^\d+$/.test(String(value || '').trim());
  }

  function isWildcardModelCandidate(value) {
    const normalized = String(value || '').trim().toUpperCase();

    if (!normalized) return false;
    if (normalized.includes(' ')) return false;
    if (normalized.includes('/')) return false;
    if (normalized.includes('(') || normalized.includes(')')) return false;
    if (isPartNumberCandidate(normalized)) return false;
    if (isDigitsOnly(normalized)) return false;
    if (!normalized.includes('?')) return false;

    const knownChars = normalized.replace(/\?/g, '');
    return knownChars.length >= 2;
  }

  function getModelBase(value) {
    return String(value || '').trim().toUpperCase().split('/')[0];
  }

  function getKnownPositionEntries(value) {
    const base = getModelBase(value);
    const entries = [];

    for (let i = 0; i < base.length; i += 1) {
      const char = base[i];
      if (char && char !== '?') {
        entries.push({ index: i, char: char });
      }
    }

    return entries;
  }

  function getLookupPrefix(value) {
    const base = getModelBase(value);
    let prefix = '';

    for (let i = 0; i < base.length; i += 1) {
      const char = base[i];
      if (char === '?') break;
      prefix += char;
    }

    return prefix;
  }

  function modelMatchesKnownPositions(modelValue, rawQuery) {
    const modelBase = getModelBase(modelValue);
    const knownEntries = getKnownPositionEntries(rawQuery);

    if (!knownEntries.length) return false;

    for (const entry of knownEntries) {
      if (modelBase.length <= entry.index) return false;
      if (modelBase[entry.index] !== entry.char) return false;
    }

    return true;
  }

  function applyRuleAt(value, index, from, to) {
    return value.slice(0, index) + to + value.slice(index + from.length);
  }

  function buildTypoVariantsOnce(value) {
    const variants = [];

    for (const rule of TYPO_RULES) {
      let startIndex = 0;

      while (startIndex < value.length) {
        const index = value.indexOf(rule.from, startIndex);
        if (index === -1) break;

        variants.push(applyRuleAt(value, index, rule.from, rule.to));
        startIndex = index + 1;
      }
    }

    return unique(variants).filter(function (v) {
      return v !== value;
    });
  }

  function buildTypoVariantsTwice(value) {
    const once = buildTypoVariantsOnce(value);
    const twice = [];

    for (const firstVariant of once) {
      twice.push(...buildTypoVariantsOnce(firstVariant));
      if (twice.length > 200) break;
    }

    return unique(twice).filter(function (v) {
      return v !== value;
    });
  }

  function isShortModelPrefixCandidate(value) {
    const normalized = String(value || '').trim().toUpperCase();

    if (!normalized) return false;
    if (normalized.includes(' ')) return false;
    if (normalized.includes('?')) return false;
    if (/[\/()]/.test(normalized)) return false;
    if (isPartNumberCandidate(normalized)) return false;
    if (isDigitsOnly(normalized)) return false;
    if (normalized.length < 3) return false;

    const hasLetter = /[A-Z]/.test(normalized);
    const hasDigit = /\d/.test(normalized);

    return hasLetter && hasDigit;
  }

  function getAvailabilityMeta(product) {
    const variant = product && product.variant ? product.variant : {};
    const terminNorm = normalizeText(product ? product.terminDodani : '');
    const isVyrazeno = terminNorm === 'vyrazeno' || terminNorm === 'vyřazeno';
    const isNeznamo = terminNorm === 'neznamo' || terminNorm === 'neznámo';

    const qtyRaw = variant.quantityAvailable;
    const hasQty = qtyRaw !== null && qtyRaw !== undefined && qtyRaw !== '';
    const qty = hasQty ? Number(qtyRaw) : 0;
    const availableForSale = Boolean(variant.availableForSale);
    const currentlyNotInStock = Boolean(variant.currentlyNotInStock);

    const isInStock =
      (hasQty && qty > 0) ||
      (!hasQty && availableForSale && !currentlyNotInStock);

    const isOrderable =
      !isVyrazeno &&
      (
        (hasQty && qty <= 0 && availableForSale) ||
        (!hasQty && availableForSale && currentlyNotInStock)
      );

    if (isInStock) {
      return {
        type: 'in',
        filterValue: 'in',
        label: qty === 1 ? 'Poslední kus skladem' : 'Skladem',
        tooltip: 'Odesíláme ihned s doručením následující pracovní den.',
        showPrice: true,
        buyDisabled: false,
        qtyValue: 1
      };
    }

    if (isOrderable) {
      return {
        type: 'order',
        filterValue: 'out',
        label: isNeznamo ? 'Upřesnění po objednání' : 'Na objednávku',
        tooltip: isNeznamo
          ? 'Termín dodání upřesníme po Vašem objednání.'
          : 'Tyto díly obvykle stíháme dodat do týdne od Vaší objednávky.',
        showPrice: true,
        buyDisabled: false,
        qtyValue: 1
      };
    }

    return {
      type: 'out',
      filterValue: 'out',
      label: 'Nelze objednat',
      tooltip: 'Tento díl je bohužel vyřazen a nelze jej již objednat.',
      showPrice: false,
      buyDisabled: true,
      qtyValue: 0
    };
  }

  function sortMatchedProducts(products) {
    const sortBy = getCurrentSortValue();
    const items = Array.isArray(products) ? products.slice() : [];

    if (sortBy === 'price-descending' || sortBy === 'price-ascending') {
      const withVisiblePrice = [];
      const withoutVisiblePrice = [];

      items.forEach(function (product) {
        const availability = getAvailabilityMeta(product);

        if (availability.showPrice) {
          withVisiblePrice.push(product);
        } else {
          withoutVisiblePrice.push(product);
        }
      });

      withVisiblePrice.sort(function (a, b) {
        const priceA = Number(a.priceAmount || 0);
        const priceB = Number(b.priceAmount || 0);

        if (sortBy === 'price-descending') {
          return priceB - priceA;
        }

        return priceA - priceB;
      });

      return withVisiblePrice.concat(withoutVisiblePrice);
    }

    return items;
  }

  function renderProductCard(product) {
    const variant = product.variant || {};
    const availability = getAvailabilityMeta(product);
    const numericVariantId = getNumericIdFromGid(variant.id);
    const productUrl = '/products/' + encodeURIComponent(product.handle || '');
    const imageHtml = product.featuredImageUrl
      ? `<img src="${escapeHtml(product.featuredImageUrl)}" loading="lazy" alt="${escapeHtml(product.featuredImageAlt || product.title || '')}">`
      : '';

    const priceHtml = availability.showPrice
      ? `
        <div class="price">
          <div class="price__container">
            <div class="price__regular">
              <span class="price-item price-item--regular">${escapeHtml(formatMoney(product.priceAmount, product.priceCurrency))}</span>
            </div>
          </div>
        </div>
      `
      : `
        <div class="price" style="visibility:hidden">
          <div class="price__container">
            <div class="price__regular">
              <span class="price-item price-item--regular">0</span>
            </div>
          </div>
        </div>
      `;

    const minusText = availability.buyDisabled ? '' : '−';
    const plusText = availability.buyDisabled ? '' : '+';

    return `
      <li
        class="grid__item"
        data-product-gid="${escapeHtml(product.id)}"
        data-availability="${escapeHtml(availability.filterValue)}"
      >
        <div class="card-wrapper product-card-wrapper">
          <div class="card card--standard card--media" tabindex="-1">
            <div class="card__inner">
              <div class="card__media">
                <a href="${escapeHtml(productUrl)}" class="media media--transparent">
                  ${imageHtml}
                </a>
              </div>
            </div>

            <div class="card__content">
              <div class="card__information">
                <h3 class="card__heading h5">
                  <a href="${escapeHtml(productUrl)}" class="full-unstyled-link">
                    ${escapeHtml(product.title || '')}
                  </a>
                </h3>

                <div class="card-information">
                  ${priceHtml}

                  <div class="boschino-stock">
                    <span class="inventory-status-with-tooltip" tabindex="0">
                      <span class="boschino-stock__status boschino-stock__status--${escapeHtml(availability.type)}">
                        ${escapeHtml(availability.label)}
                      </span>
                      <span class="inventory-tooltip">
                        ${escapeHtml(availability.tooltip)}
                      </span>
                    </span>
                  </div>
                </div>
              </div>

              <div class="boschino-actions">
                <form method="post" action="/cart/add" class="boschino-card-buy" data-boschino-card-buy>
                  <input type="hidden" name="id" value="${escapeHtml(numericVariantId)}">

                  <div class="boschino-quantity" data-boschino-qty>
                    <button type="button" class="boschino-minus" data-qty-minus ${availability.buyDisabled ? 'disabled' : ''} aria-label="Odebrat 1 ks">${minusText}</button>

                    <input
                      type="number"
                      name="quantity"
                      value="${availability.qtyValue}"
                      min="${availability.buyDisabled ? '0' : '1'}"
                      step="1"
                      inputmode="numeric"
                      pattern="[0-9]*"
                      aria-label="Počet kusů"
                      data-qty-input

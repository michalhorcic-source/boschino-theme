    </span>
  </span>
</div>

                </div>
              </div>

              <div class="boschino-actions">
                <form method="post" action="/cart/add" class="boschino-card-buy" data-boschino-card-buy>
                  <input type="hidden" name="id" value="{{ variant.id }}">

                  <div class="boschino-quantity" data-boschino-qty>
                    <button type="button" class="boschino-minus" data-qty-minus aria-label="Odebrat 1 ks"></button>

                    <input
                      type="number"
                      name="quantity"
                      value="1"
                      min="1"
                      step="1"
                      inputmode="numeric"
                      pattern="[0-9]*"
                      aria-label="Počet kusů"
